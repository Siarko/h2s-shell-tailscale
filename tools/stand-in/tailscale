#!/bin/sh
# h2s-stand-in: a stand-in `tailscale` CLI for the module's end-to-end tests: a small state machine over
# the redacted fixtures. It never touches a real tailscaled or the network. Put
# tools/stand-in first on PATH (or name it by absolute path where the module takes one).
#
# Environment:
#   TS_FAKE_FIXTURES     the fixtures directory (default: ../../fixtures from this script)
#   TS_FAKE_STATE_DIR    where the state lives between calls (default:
#                        ${XDG_RUNTIME_DIR:-/tmp}/ts-fake-$(id -u)); one directory per test
#   TS_FAKE_STATE        force a scenario for this call (else the state dir's, else running):
#                        running | stopped | starting | needs-login | needs-machine-auth |
#                        exit-node | exit-node-offline | key-expiring | key-expired |
#                        health-warnings | update-available | rich | sharing | serve |
#                        not-running ("serve": status-serve.json, HTTPS + Funnel enabled) |
#                        fresh | fresh-needs-login (a daemon fresh from the package: no
#                        profile, no node key, WantRunning off; NoState or NeedsLogin)
#   TS_FAKE_DAEMON       "down": the daemon is not running (every daemon command fails);
#                        so is it while the state dir holds a file "daemon-down" (the stand-in
#                        systemctl removes it on `start tailscaled.service`)
#   TS_FAKE_OPERATOR     1: the caller may change (operator); 0 (default, as on the machine
#                        the fixtures come from): changes are denied with the real text.
#                        Also allowed: TS_FAKE_ROOT=1 (set by the stand-in pkexec), or a
#                        `set --operator=<user>` done earlier for TS_FAKE_USER (default $USER)
#   TS_FAKE_LOGIN_DELAY  seconds `login` / `up` wait after printing the auth URL (default 2)
#   TS_FAKE_LOGIN_RESULT "fail": the login ends with an error instead of success
#   TS_FAKE_BUS_DELAY    seconds between the objects `debug watch-ipn` prints (default 0)
#   TS_FAKE_PING         "timeout": ping gets no reply
#   TS_FAKE_NETCHECK     "fail": netcheck fails
#   TS_FAKE_LOGIN_URL_DELAY  seconds a `login` waits before it prints its URL (after the move
#                        to the empty profile)
#   TS_FAKE_LOGIN_DENY_AFTER_SWITCH  1: a `login` not as root moves to the empty profile, then
#                        is denied
#   TS_FAKE_LOGIN_SAME   1: a `login` from a logged-in profile logs in with the same account:
#                        merged into its profile with login's default prefs (the old ones
#                        lost, as the daemon does); else it adds account e5f6
#                        (user2@example.net). Each profile keeps its prefs (prefs.<id>)
#   TS_FAKE_UP_DELAY     seconds a bare `up` from Stopped waits before it reaches Running (a
#                        daemon that cannot get there: offline, a captive portal); default 0.
#                        Also a file "up-delay" in the state dir holding the seconds
#   TS_FAKE_UP_URL       1: that slow `up` first prints a login URL to stderr (as `up` does
#                        when the key expired), then waits
#   TS_FAKE_STATUS_HANG  seconds `status --json` hangs before it answers (a stuck daemon);
#                        also a file "status-hang" in the state dir holding the seconds
#                        A file "status-hold" in the state dir: `status` waits until the
#                        file is gone (a test lets the read go when it is ready for it)
#   TS_FAKE_LOG          a file each call's arguments are appended to (one line per call)
#   TS_FAKE_SSH_CAP      0: the tailnet does not allow Tailscale SSH (`set --ssh` refused as the
#                        daemon does); also a file "no-ssh-cap" in the state dir
#   TS_FAKE_AUTO_UPDATE  ok: `set --auto-update` allowed (default: refused, as on NixOS)
#   TS_FAKE_SEND_DELAY   seconds between a `file cp` file's bus updates (0 none: started, then finished)
#   TS_FAKE_SEND_FAIL    1: the first file fails halfway (Finished, not Succeeded; exit 1)
#   TS_FAKE_SEND_REFUSE  a reason: `file cp` is refused with "cannot send files: <reason>"
#   Taildrop: `file cp -- <files…> <100.64.0.N>:` checks the files, needs write access (root or
#   the operator), appends OutgoingFiles lines to TS_FAKE_BUS_FILE and copies each file into
#   the state dir's sent/; the inbox (receiving) is the stand-in curl's files/
#   SSH_CLIENT           from a 100.x address: `set --ssh=<change>` asks for the lose-ssh risk
#                        and, with no terminal, aborts (as the real CLI)
#   TS_FAKE_CERT_DELAY   seconds `cert` takes to "issue" (after its checks, before writing)
#   TS_FAKE_CERT_NOT_AFTER  the expiry written into the stand-in cert (default
#                        "Feb 14 12:00:00 2027 GMT"); the stand-in openssl reads it back
#
# Serve and Funnel (step 5), as cli/serve_v2.go with the daemon's checks (ipn/localapi/serve.go,
# ipnlocal setServeConfigLocked). State dir file "serve.json": the ServeConfig the daemon holds
# (absent: none, `{}`), printed verbatim by `serve status --json`, rewritten (in Go's
# MarshalIndent shape: sorted keys, omitempty) by every change the stand-in makes. A test may
# seed it with raw JSON: it is parsed into a table (T <port> <HTTPS|HTTP|TCPForward|TerminateTLS>
# <value> / W <host:port> <mount> <Path|Proxy|Text> <value> / F <host:port> <true|false>,
# tab-separated); a seeded config holding anything else (Services, Foreground, Redirect,
# AcceptAppCaps, ProxyProtocol, unknown fields, …) is still printed verbatim, but a change to it
# is refused: exit 2 "stand-in: serve.json holds … not replayed; changes not replayed" (`reset`
# still replaces it). Changes need write access (the denial "sending serve config: Access
# denied: serve config denied"); a config with a Path handler needs root (TS_FAKE_ROOT=1); Funnel
# on with ShieldsUp is refused. `serve`/`funnel` without --bg (foreground), with --service, --tun,
# --accept-app-caps, --proxy-protocol or a unix: target are refused: exit 2 "not replayed".
# State dir file "serve-next.json": moved over serve.json when the next `funnel` run as root
# starts (a change by another client while the password dialog was open); "serve-fail-after-write":
# that run then fails after it wrote the config (removed by it).
# State dir files read by `status --json` (and so by serve, funnel and cert):
#   caps          extra capability names, one per line, added to Self's CapMap (as `"<name>":
#                 null`): "https" (HTTPS certs: serve over HTTPS), "funnel", and
#                 "https://tailscale.com/cap/funnel-ports?ports=443,8443" (the Funnel ports)
#   cert-domains  one domain per line: status's CertDomains (else the fixture's, null in all
#                 but status-serve.json); `cert` issues only for these
# `cert [--cert-file=F] [--key-file=K] [--min-validity=D] <domain>` writes stand-in PEM text
# ("STAND-IN <domain> notAfter=<date>") to F (0644) and K (0600), atomically (a temp file in the
# same directory, renamed), default <domain>.crt / .key in the working directory.
# State dir file "lock.json": what `lock status --json` prints (absent: lock-disabled.json, as
# the real CLI prints with tailnet lock off); `lock status` prints its text form.
#
# Sharing (step 3): `set --advertise-routes` / `--advertise-exit-node` compose as set.go's
# calcAdvertiseRoutesForSet (each alone keeps the other half of AdvertiseRoutes), routes are
# checked as netutil.CalcAdvertiseRoutes (host bits for IPv4 only), offering an exit node while
# using one (or the reverse) is refused with the daemon's text. An admin's approval is the
# state dir's file "approved" (one route per line): those advertised routes show in status's
# Self AllowedIPs (subnets also in PrimaryRoutes, the exit pair as ExitNodeOption). A
# `--hostname` set while not Running reaches status's Self only with the next `up`.
#
# State dir file "on-deny": a snippet run once when a write is denied ($1 the state dir).
# State dir files: scenario (the status fixture's name), prefs (key=value overrides of the
# prefs fixture), resume (the scenario `up` returns to), profiles and current (the accounts:
# see profiles_init), login-from (the account a pending `login` started from).
# shellcheck disable=SC2016 # the awk programs are single-quoted on purpose
set -eu

here=$(cd "$(dirname "$0")" && pwd)
F=${TS_FAKE_FIXTURES:-$here/../../fixtures}
STATE_DIR=${TS_FAKE_STATE_DIR:-${XDG_RUNTIME_DIR:-/tmp}/ts-fake-$(id -u)}
mkdir -p "$STATE_DIR"
[ -n "${TS_FAKE_LOG:-}" ] && printf '%s\n' "$*" >> "$TS_FAKE_LOG"

scenario=${TS_FAKE_STATE:-}
[ -z "$scenario" ] && [ -f "$STATE_DIR/scenario" ] && scenario=$(cat "$STATE_DIR/scenario")
[ -z "$scenario" ] && scenario=running
[ "${TS_FAKE_DAEMON:-}" = down ] && scenario=not-running
# The daemon stopped by a test (a file, so that a stand-in systemctl can start it again)
[ -f "$STATE_DIR/daemon-down" ] && scenario=not-running

save_scenario() { printf '%s\n' "$1" > "$STATE_DIR/scenario"; scenario=$1; }

# key=value overrides of the prefs, the last one of a key wins
set_pref() { printf '%s=%s\n' "$1" "$2" >> "$STATE_DIR/prefs"; }
get_pref() { [ -f "$STATE_DIR/prefs" ] && sed -n "s/^$1=//p" "$STATE_DIR/prefs" | tail -n 1; return 0; }

need_daemon() {
    if [ "$scenario" = not-running ]; then
        cat "$F/stderr-not-running.txt" >&2
        exit 1
    fi
}

can_write() {
    [ "${TS_FAKE_ROOT:-0}" = 1 ] && return 0
    [ "${TS_FAKE_OPERATOR:-0}" = 1 ] && return 0
    operator=$(get_pref OperatorUser)
    [ -n "$operator" ] && [ "$operator" = "${TS_FAKE_USER:-${USER:-}}" ] && return 0
    return 1
}

# The real denial: LocalAPI's 403 text, then the CLI's advice with the command as typed
denied() {
    what=$1
    shift
    # A change made elsewhere at that moment (a test's "meanwhile"): the state dir's file
    # "on-deny", a shell snippet run once with $1 = the state dir, then removed
    if [ -f "$STATE_DIR/on-deny" ]; then
        hook=$(cat "$STATE_DIR/on-deny")
        rm -f "$STATE_DIR/on-deny"
        sh -c "$hook" sh "$STATE_DIR"
    fi
    # deny_prefix: the CLI's own wrapping of the LocalAPI error ("sending serve config: ")
    printf "%sAccess denied: %s\n\nUse 'sudo tailscale %s'.\nTo not require root, use 'sudo tailscale set --operator=\$USER' once.\n" "${deny_prefix:-}" "$what" "$*" >&2
    exit 1
}
need_write() { # $1 the denial text, then the command as typed
    what=$1
    shift
    can_write || denied "$what" "$@"
}

# Waits $1 seconds, ended with its sleep by TERM (as the module's timeout or the module ends it).
# The trap is there before the sleep is started: a TERM that lands while the sleep is being
# started still takes it along ($!: the sleep, once it is started)
pause() {
    trap 'kill "$!" 2> /dev/null; exit 143' TERM INT HUP
    sleep "$1" &
    wait "$!"
    trap - TERM INT HUP
}

status_fixture() {
    case $scenario in
        login-pending) echo "$F/status-needs-login.json"; return ;;
    esac
    # The account in use may have a fixture of its own (status-running-work.json)
    suffix=$(profile_field "$(current_profile)" 5)
    if [ -n "$suffix" ] && [ -f "$F/status-$scenario-$suffix.json" ]; then
        echo "$F/status-$scenario-$suffix.json"
    else
        echo "$F/status-$scenario.json"
    fi
}

# The status fixture, with the name the tailnet knows (a --hostname set while connected, or
# applied by the next `up`: StatusHostname) as this computer's (Self's HostName and the first
# label of its DNSName: the first of each in the fixtures), and the advertised routes an admin
# approved (the file "approved" in the state dir, one route per line) in Self's AllowedIPs —
# subnet routes in PrimaryRoutes too, the exit-node pair as ExitNodeOption (as ipnlocal's
# peerStatusFromNode fills them)
print_status() {
    hostname=$(get_pref StatusHostname)
    approved=""
    if [ -f "$STATE_DIR/approved" ]; then
        advertised=$(current_routes)
        while IFS= read -r route; do
            [ -n "$route" ] && has_route "$advertised" "$route" && approved="${approved:+$approved,}$route"
        done < "$STATE_DIR/approved"
    fi
    if [ -n "$hostname" ]; then
        sed "0,/\"HostName\": \"[^\"]*\"/s//\"HostName\": \"$hostname\"/; 0,/\"DNSName\": \"[^.\"]*\./s//\"DNSName\": \"$hostname./" "$(status_fixture)"
    else
        cat "$(status_fixture)"
    fi | awk -v approved="$approved" '
        BEGIN { n = split(approved, list, ","); exit4 = 0; exit6 = 0; subnets = ""
                for (i = 1; i <= n; i++) { if (list[i] == "0.0.0.0/0") exit4 = 1; else if (list[i] == "::/0") exit6 = 1
                                            else subnets = subnets (subnets == "" ? "" : ",") list[i] } }
        # Self is the first object with four-space keys; its AllowedIPs is the first such array
        !self_done && /^    "AllowedIPs": \[/ { in_allowed = 1; print; next }
        in_allowed && /^    \]/ {
            for (i = 1; i <= n; i++) print "      ,\"" list[i] "\""
            print
            if (subnets != "") { m = split(subnets, sub_list, ","); print "    \"PrimaryRoutes\": ["
                for (i = 1; i <= m; i++) print "      " (i > 1 ? "," : "") "\"" sub_list[i] "\""; print "    ]," }
            in_allowed = 0; self_done = 1; next }
        !exit_done && /^    "ExitNodeOption": / { exit_done = 1; if (exit4 && exit6) { print "    \"ExitNodeOption\": true,"; next } }
        { print }' | status_extras
}

# The state dir's "caps" (one capability per line) into Self's CapMap — the first "CapMap" —,
# its "cert-domains" (one per line) as the top-level CertDomains
status_extras() {
    caps=""
    [ -f "$STATE_DIR/caps" ] && caps=$(grep -v '^[[:space:]]*$' "$STATE_DIR/caps" | tr '\n' '\001')
    domains=""
    has_domains=0
    if [ -f "$STATE_DIR/cert-domains" ]; then
        has_domains=1
        domains=$(grep -v '^[[:space:]]*$' "$STATE_DIR/cert-domains" | tr '\n' '\001')
    fi
    awk -v caps="$caps" -v domains="$domains" -v has_domains="$has_domains" '
        function nonempty(list, out,   all, m, k, j) {
            m = split(list, all, "\001"); j = 0
            for (k = 1; k <= m; k++) if (all[k] != "") out[++j] = all[k]
            return j
        }
        BEGIN { ncaps = nonempty(caps, cap); ndomains = nonempty(domains, domain) }
        function print_domains(   k) {
            if (ndomains == 0) { print "  \"CertDomains\": null,"; return }
            print "  \"CertDomains\": ["
            for (k = 1; k <= ndomains; k++) print "    \"" domain[k] "\"" (k < ndomains ? "," : "")
            print "  ],"
        }
        !caps_done && /"CapMap": \{\}/ && ncaps > 0 {
            caps_done = 1; indent = $0; sub(/".*/, "", indent)
            print indent "\"CapMap\": {"
            for (k = 1; k <= ncaps; k++) print indent "  \"" cap[k] "\": null" (k < ncaps ? "," : "")
            print indent "}" ($0 ~ /,[[:space:]]*$/ ? "," : ""); next }
        !caps_done && /"CapMap": \{[[:space:]]*$/ {
            caps_done = 1; print; indent = $0; sub(/".*/, "", indent)
            for (k = 1; k <= ncaps; k++) print indent "  \"" cap[k] "\": null,"
            next }
        has_domains && /^  "CertDomains": null/ { print_domains(); next }
        has_domains && /^  "CertDomains": \[/ { print_domains(); skip = 1; next }
        skip { if ($0 ~ /^  \]/) skip = 0; next }
        { print }'
}

prefs_base() {
    case $scenario in
        stopped) echo "$F/prefs-stopped.json" ;;
        needs-login | login-pending) echo "$F/prefs-logged-out.json" ;;
        fresh | fresh-needs-login) echo "$F/prefs-fresh.json" ;;
        # An expired key is not a logout: the prefs stay those of a logged-in machine
        key-expired) echo "$F/prefs-running.json" ;;
        exit-node | exit-node-offline) echo "$F/prefs-exit-node.json" ;;
        rich) echo "$F/prefs-rich.json" ;;
        sharing) echo "$F/prefs-sharing.json" ;;
        # serve (status-serve.json: HTTPS and Funnel enabled) keeps the running prefs
        *) echo "$F/prefs-running.json" ;;
    esac
}


# Accounts (profiles): "profiles" in the state dir, one per line — id, nickname, tailnet,
# account, the status fixture's suffix ("" the plain one; "work": status-running-work.json) —
# tab-separated; "current" the id in use ("" a new, empty profile: `login` while logged in
# starts one). Two accounts to begin with, as switch-list.json.
profiles_init() {
    [ -f "$STATE_DIR/profiles" ] && return 0
    printf 'a1b2\t\texample-tailnet.ts.net\tuser1@example.com\t\nc3d4\twork\texample.org\tuser1@example.org\twork\n' > "$STATE_DIR/profiles"
    [ -f "$STATE_DIR/current" ] || printf 'a1b2\n' > "$STATE_DIR/current"
}
current_profile() { profiles_init; cat "$STATE_DIR/current" 2> /dev/null || true; }
profile_field() { # profile_field <id> <column 1-5>
    awk -F '\t' -v id="$1" -v column="$2" '$1 == id { print $column; exit }' "$STATE_DIR/profiles"
}
profile_exists() { profiles_init; [ -n "$1" ] && awk -F '\t' -v id="$1" '$1 == id { found = 1 } END { exit !found }' "$STATE_DIR/profiles"; }
print_profiles() { # --json or the table
    profiles_init
    current=$(current_profile)
    if [ "${1:-}" = json ]; then
        awk -F '\t' -v current="$current" 'BEGIN { printf "[" } { printf "%s\n  {\n    \"id\": \"%s\",\n    \"nickname\": \"%s\",\n    \"tailnet\": \"%s\",\n    \"account\": \"%s\",\n    \"selected\": %s\n  }", (NR > 1 ? "," : ""), $1, $2, $3, $4, ($1 == current ? "true" : "false") } END { print "\n]" }' "$STATE_DIR/profiles"
    else
        printf 'ID    Tailnet                 Account\n'
        awk -F '\t' -v current="$current" '{ printf "%-5s %-23s %s%s\n", $1, $3, $4, ($1 == current ? "*" : "") }' "$STATE_DIR/profiles"
    fi
}

json_string() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# The prefs fixture with the overrides applied (one "Key": value per line in the fixtures)
print_prefs() {
    base=$(prefs_base)
    script=""
    for key in RouteAll CorpDNS ShieldsUp ExitNodeAllowLANAccess RunSSH RunWebClient WantRunning LoggedOut NoSNAT NoStatefulFiltering PostureChecking; do
        value=$(get_pref "$key")
        [ -n "$value" ] && script="$script s/^\\(  \"$key\": \\)[a-z]*/\\1$value/;"
    done
    # Nested ones: AppConnector.Advertise, AutoUpdate.Check / .Apply (four spaces in)
    value=$(get_pref AppConnectorAdvertise)
    [ -n "$value" ] && script="$script s/^\\(    \"Advertise\": \\)[a-z]*/\\1$value/;"
    value=$(get_pref UpdateCheck)
    [ -n "$value" ] && script="$script s/^\\(    \"Check\": \\)[a-z]*/\\1$value/;"
    value=$(get_pref AutoUpdateApply)
    [ -n "$value" ] && script="$script s/^\\(    \"Apply\": \\)[a-z]*/\\1$value/;"
    # RelayServerPort: omitted while off (Go's omitempty), a number when on
    value=$(get_pref RelayServerPort)
    [ -n "$value" ] && script="$script s/^\\(  \"Hostname\": .*\\)$/\\1\\n  \"RelayServerPort\": $value,/;"
    value=$(get_pref ExitNodeID)
    [ -f "$STATE_DIR/prefs" ] && grep -q '^ExitNodeID=' "$STATE_DIR/prefs" \
        && script="$script s/^\\(  \"ExitNodeID\": \\)\"[^\"]*\"/\\1\"$value\"/;"
    if grep -q '^Hostname=' "$STATE_DIR/prefs" 2> /dev/null; then
        value=$(json_string "$(get_pref Hostname)")
        script="$script s/^\\(  \"Hostname\": \\)\"[^\"]*\"/\\1\"$value\"/;"
    fi
    operator=$(get_pref OperatorUser)
    if [ -n "$operator" ]; then
        # The fixtures have no OperatorUser line (Go omits it while empty): add one
        grep -q '"OperatorUser"' "$base" \
            && script="$script s/^\\(  \"OperatorUser\": \\)\"[^\"]*\"/\\1\"$operator\"/;" \
            || script="$script s/^\\(  \"Hostname\": .*\\)$/\\1\\n  \"OperatorUser\": \"$operator\",/;"
    fi
    # The account in use names the prefs' login (an empty profile: none)
    if [ -f "$STATE_DIR/current" ]; then
        account=$(profile_field "$(current_profile)" 4)
        # The account's nickname is the prefs' ProfileName (`set --nickname`)
        nickname=$(profile_field "$(current_profile)" 2)
        [ -n "$nickname" ] && script="$script s/^\\(  \"Hostname\": .*\\)$/\\1\\n  \"ProfileName\": \"$nickname\",/;"
        script="$script s/^\\(      \"LoginName\": \\)\"[^\"]*\"/\\1\"$account\"/;"
    fi
    # AdvertiseRoutes from its override (null when empty), else as the fixture has it
    if grep -q '^AdvertiseRoutes=' "$STATE_DIR/prefs" 2> /dev/null; then
        sed "$script" "$base" | awk -v routes="$(get_pref AdvertiseRoutes)" '
            /^  "AdvertiseRoutes": / {
                if (routes == "") print "  \"AdvertiseRoutes\": null,"
                else { n = split(routes, list, ","); print "  \"AdvertiseRoutes\": ["
                       for (i = 1; i <= n; i++) print "    \"" list[i] "\"" (i < n ? "," : ""); print "  ]," }
                if ($0 ~ /\[$/) skip = 1
                next }
            skip { if ($0 ~ /^  \]/) skip = 0; next }
            { print }'
    else
        sed "$script" "$base"
    fi
}

bool_flag() { # --name or --name=true|false → true|false; anything else: Go's flag error
    case $1 in
        *=true | *=1) echo true ;;
        *=false | *=0) echo false ;;
        *=*) echo "invalid boolean value \"${1#*=}\" for ${1%%=*}: parse error" >&2; exit 2 ;;
        *) echo true ;;
    esac
}

bool_pref() { value=$(bool_flag "$2") || exit 2; set_pref "$1" "$value"; }

exit_node_id() { # the argument of --exit-node → a node id, or "" when no node matches
    case $1 in
        "") echo "" ;;
        peer4 | 100.64.0.4 | peer4.example-tailnet.ts.net | peer4.example-tailnet.ts.net.) echo nPEER4CNTRL ;;
        peer10 | 100.64.0.10 | peer10.example-tailnet.ts.net | peer10.example-tailnet.ts.net.) echo nPEER10CNTRL ;;
        auto:any) echo nPEER4CNTRL ;;
        *) echo "?" ;;
    esac
}

# The current profile's prefs overrides kept under its id (an empty profile: none kept)
save_profile_prefs() {
    [ -n "$1" ] || return 0
    if [ -f "$STATE_DIR/prefs" ]; then cp "$STATE_DIR/prefs" "$STATE_DIR/prefs.$1"; else : > "$STATE_DIR/prefs.$1"; fi
}
# login's defaults, over whatever fixture the scenario reads (accept routes off, no exit node,
# no hostname, no operator)
default_prefs() {
    printf 'RouteAll=false\nCorpDNS=true\nShieldsUp=false\nExitNodeAllowLANAccess=false\nRunSSH=false\nExitNodeID=\nHostname=\nWantRunning=false\nStatusHostname=\nAdvertiseRoutes=\nRunWebClient=false\n' > "$STATE_DIR/prefs"
}

login_flow() {
    profiles_init
    case $scenario in
        needs-login | login-pending | key-expired | fresh | fresh-needs-login) ;;
        *)
            # Logged in: `login` first moves to a new, empty profile (cli/login.go:
            # SwitchToEmptyProfile) — before any URL: the connection drops at once. The one
            # before keeps its prefs (saved per profile); the empty one has login's defaults
            from=$(current_profile)
            printf '%s\n' "$from" > "$STATE_DIR/login-from"
            save_profile_prefs "$from"
            default_prefs
            : > "$STATE_DIR/current" ;;
    esac
    save_scenario login-pending
    # A login refused after that move (TS_FAKE_LOGIN_DENY_AFTER_SWITCH=1, not as root): the
    # daemon stays on the empty profile
    if [ "${TS_FAKE_LOGIN_DENY_AFTER_SWITCH:-0}" = 1 ] && [ "${TS_FAKE_ROOT:-0}" != 1 ]; then
        denied "prefs write access denied" login
    fi
    # The URL may come late (TS_FAKE_LOGIN_URL_DELAY seconds): the move happened already
    [ "${TS_FAKE_LOGIN_URL_DELAY:-0}" != 0 ] && pause "$TS_FAKE_LOGIN_URL_DELAY"
    printf '\nTo authenticate, visit:\n\n\thttps://login.tailscale.com/a/REDACTED\n\n' >&2
    # Killable while it waits (the module ends a login that takes too long): the sleep goes too
    pause "${TS_FAKE_LOGIN_DELAY:-2}"
    if [ "${TS_FAKE_LOGIN_RESULT:-}" = fail ]; then
        save_scenario needs-login
        echo "backend error: example login failure" >&2
        exit 1
    fi
    from=$(cat "$STATE_DIR/login-from" 2> /dev/null || true)
    rm -f "$STATE_DIR/login-from"
    if [ -z "$(current_profile)" ]; then
        if [ -n "$from" ] && [ "${TS_FAKE_LOGIN_SAME:-0}" = 1 ]; then
            # The same account again: the daemon merges the new profile into its old one
            # — with the new profile's prefs, login's defaults (ipnlocal/profiles.go): the old
            # exit node, routes, hostname, nickname and operator are gone
            printf '%s\n' "$from" > "$STATE_DIR/current"
            rm -f "$STATE_DIR/prefs.$from"
            awk -F '\t' -v OFS='\t' -v id="$from" '$1 == id { $2 = "" } { print }' "$STATE_DIR/profiles" > "$STATE_DIR/profiles.new"
            mv "$STATE_DIR/profiles.new" "$STATE_DIR/profiles"
        else
            # Another account (TS_FAKE_LOGIN_SAME=1: the same one)
            grep -q '^e5f6	' "$STATE_DIR/profiles" || printf 'e5f6\t\texample.net\tuser2@example.net\t\n' >> "$STATE_DIR/profiles"
            printf 'e5f6\n' > "$STATE_DIR/current"
        fi
    fi
    set_pref LoggedOut false
    set_pref WantRunning true
    save_scenario running
    printf 'Success.\n' >&2
}

negate() { [ "$1" = true ] && echo false || echo true; }

# The status fixture says Running (the tailnet hears about prefs changes only then)
is_running() { grep -q '"BackendState": "Running"' "$(status_fixture)"; }

# A key's value in the printed prefs (one "Key": value line, two spaces in)
prefs_value() { print_prefs | sed -n "s/^  \"$1\": \"\{0,1\}\([^\"]*\)\"\{0,1\},\{0,1\}\$/\1/p" | head -n 1; }

# AdvertiseRoutes as a comma list: the override, else the fixture's array
current_routes() {
    if grep -q '^AdvertiseRoutes=' "$STATE_DIR/prefs" 2> /dev/null; then
        get_pref AdvertiseRoutes
    else
        awk '/^  "AdvertiseRoutes": \[/ { on = 1; next } on && /^  \]/ { exit } on { gsub(/[ ",]/, ""); if ($0 != "") list = list (list == "" ? "" : ",") $0 } END { print list }' "$(prefs_base)"
    fi
}
has_route() { case ",$1," in *",$2,"*) return 0 ;; esac; return 1; }
advertises_exit() { has_route "$1" 0.0.0.0/0 && has_route "$1" ::/0; }

# net/netutil/routes.go CalcAdvertiseRoutes: each prefix parsed (an address alone is not one),
# no host bits (checked for IPv4 here), a /0 only with its other-family twin; the exit pair
# added when asked; deduplicated, sorted by prefix length. Prints the list or fails as the CLI
calc_routes() { # calc_routes <comma list> <true|false: add the exit pair>
    list=""
    default4=false
    default6=false
    old_ifs=$IFS
    IFS=,
    for route in $1; do
        IFS=$old_ifs
        case $route in
            *.*.*.*/*)
                masked=$(printf '%s\n' "$route" | awk -F '[./]' 'NF == 5 && $5 ~ /^(0|[1-9][0-9]?)$/ && $5 + 0 <= 32 {
                    for (i = 1; i <= 4; i++) if ($i !~ /^(0|[1-9][0-9]?[0-9]?)$/ || $i + 0 > 255) exit
                    out = ""
                    for (i = 1; i <= 4; i++) { keep = $5 - (i - 1) * 8; keep = keep < 0 ? 0 : (keep > 8 ? 8 : keep)
                        step = 2 ^ (8 - keep); out = out (i > 1 ? "." : "") int($i / step) * step }
                    print out "/" $5 }')
                [ -n "$masked" ] || { printf '"%s" is not a valid IP address or CIDR prefix\n' "$route" >&2; exit 1; }
                [ "$masked" = "$route" ] || { printf '%s has non-address bits set; expected %s\n' "$route" "$masked" >&2; exit 1; } ;;
            *:*/*)
                printf '%s\n' "$route" | grep -Eq '^[0-9a-fA-F:]+/(0|[1-9][0-9]?|1[01][0-9]|12[0-8])$' \
                    || { printf '"%s" is not a valid IP address or CIDR prefix\n' "$route" >&2; exit 1; } ;;
            *) printf '"%s" is not a valid IP address or CIDR prefix\n' "$route" >&2; exit 1 ;;
        esac
        [ "$route" = 0.0.0.0/0 ] && default4=true
        [ "$route" = ::/0 ] && default6=true
        has_route "$list" "$route" || list="${list:+$list,}$route"
        IFS=,
    done
    IFS=$old_ifs
    [ $default4 = true ] && [ $default6 = false ] && { echo "0.0.0.0/0 advertised without its IPv6 counterpart, please also advertise ::/0" >&2; exit 1; }
    [ $default6 = true ] && [ $default4 = false ] && { echo "::/0 advertised without its IPv4 counterpart, please also advertise 0.0.0.0/0" >&2; exit 1; }
    if [ "$2" = true ]; then
        has_route "$list" 0.0.0.0/0 || list="${list:+$list,}0.0.0.0/0"
        has_route "$list" ::/0 || list="${list:+$list,}::/0"
    fi
    printf '%s\n' "$list" | tr , '\n' | awk -F / 'NF { print $2 "\t" $0 }' | sort -n -s -k1,1 | cut -f2 | paste -sd , -
}

# The checks of a `set` before anything is written (set.go, then the daemon's checkPrefs):
# leaves new_routes / old_routes for the writes
set_checks() {
    routes_given=false
    exit_given=false
    exit_value=false
    exit_node_after=$(prefs_value ExitNodeID)
    ssh_after=""
    risk=""
    for argument in "$@"; do
        case $argument in
            --advertise-routes=*) routes_given=true; routes_value=${argument#--advertise-routes=} ;;
            --advertise-exit-node | --advertise-exit-node=*) exit_given=true; exit_value=$(bool_flag "$argument") || exit 2 ;;
            --exit-node=*) exit_node_after=$(exit_node_id "${argument#--exit-node=}") ;;
            --ssh | --ssh=*) ssh_after=$(bool_flag "$argument") || exit 2 ;;
            --accept-risk=*) risk=${argument#--accept-risk=} ;;
            --relay-server-port=*)
                port=${argument#--relay-server-port=}
                if [ -n "$port" ]; then
                    printf '%s\n' "$port" | grep -Eq '^[0-9]{1,5}$' && [ "$port" -le 65535 ] \
                        || { printf 'failed to set relay server port: strconv.ParseUint: parsing "%s": invalid syntax\n' "$port" >&2; exit 1; }
                fi ;;
            --auto-update | --auto-update=*)
                # NixOS: the daemon cannot update itself (ipnlocal checkAutoUpdatePrefsLocked)
                if [ "$(bool_flag "$argument")" = true ] && [ "${TS_FAKE_AUTO_UPDATE:-}" != ok ]; then
                    echo "Auto-updates are not supported on this platform." >&2
                    exit 1
                fi ;;
            --accept-routes* | --accept-dns* | --shields-up* | --exit-node-allow-lan-access* | --webclient* | --update-check* \
                | --report-posture* | --advertise-connector* | --snat-subnet-routes* | --stateful-filtering* | --hostname=* \
                | --nickname=* | --operator=*) ;;
            *)
                name=${argument%%=*}
                printf 'flag provided but not defined: -%s\n' "${name#--}" >&2
                exit 2 ;;
        esac
    done
    old_routes=$(current_routes)
    new_routes=$old_routes
    if [ $routes_given = true ] && [ $exit_given = true ]; then
        new_routes=$(calc_routes "$routes_value" "$exit_value") || exit 1
    elif [ $routes_given = true ]; then
        advertises_exit "$old_routes" && was=true || was=false
        new_routes=$(calc_routes "$routes_value" "$was") || exit 1
    elif [ $exit_given = true ]; then
        advertises_exit "$old_routes" && was=true || was=false
        if [ "$was" != "$exit_value" ]; then
            kept=$(printf '%s\n' "$old_routes" | tr , '\n' | grep -v '/0$' | paste -sd , -)
            new_routes=$(calc_routes "$kept" "$exit_value") || exit 1
        fi
    fi
    # The daemon's checkExitNodePrefsLocked
    if [ -n "$exit_node_after" ] && [ "$exit_node_after" != "?" ] && advertises_exit "$new_routes"; then
        echo "Cannot advertise an exit node and use an exit node at the same time." >&2
        exit 1
    fi
    if [ -n "$ssh_after" ]; then
        # checkSSHPrefsLocked: the tailnet must allow it (TS_FAKE_SSH_CAP=0 or a file
        # "no-ssh-cap": it does not)
        if [ "$ssh_after" = true ] && { [ "${TS_FAKE_SSH_CAP:-1}" = 0 ] || [ -f "$STATE_DIR/no-ssh-cap" ]; }; then
            echo "Unable to enable local Tailscale SSH server; not enabled on Tailnet. See https://tailscale.com/s/ssh" >&2
            exit 1
        fi
        # cli/up.go presentSSHToggleRisk: only inside an SSH session over Tailscale (SSH_CLIENT
        # from a 100.x address); with no terminal the prompt answers no
        case ${SSH_CLIENT:-} in
            100.*)
                if [ "$ssh_after" != "$(prefs_value RunSSH)" ] && [ "$risk" != lose-ssh ] && [ "$risk" != all ]; then
                    echo "You are connected over Tailscale; this action will reroute SSH traffic to Tailscale SSH and will result in your session disconnecting."
                    echo "To skip this warning, use --accept-risk=lose-ssh"
                    echo "aborted, no changes made" >&2
                    exit 1
                fi ;;
        esac
    fi
}

# ---- Serve and Funnel (step 5) ----

SERVE_JSON=$STATE_DIR/serve.json

# serve.json → the table (see the header); a first line "!<what>" when it holds anything the
# table cannot (the config is then printed, never changed)
SERVE_PARSE='
function ws() { while (i <= n && index(" \t\r\n", substr(s, i, 1)) > 0) i++ }
function fail(why) { if (bad == "") bad = why; i = n + 1 }
function jstr(   c, out, h) {
    i++; out = ""
    while (i <= n) {
        c = substr(s, i, 1)
        if (c == "\"") { i++; return out }
        if (c == "\\") {
            c = substr(s, i + 1, 1); i += 2
            if (c == "u") {
                h = tolower(substr(s, i, 4)); i += 4
                if (h == "003c") out = out "<"; else if (h == "003e") out = out ">"; else if (h == "0026") out = out "&"
                else { fail("a \\u" h " escape"); return out }
            } else if (c == "\"" || c == "\\" || c == "/") out = out c
            else { fail("a \\" c " escape"); return out }
            continue
        }
        out = out c; i++
    }
    fail("an unterminated string"); return out
}
function value(path,   c, k, lit, idx) {
    ws()
    if (i > n) { fail("truncated JSON"); return }
    c = substr(s, i, 1)
    if (c == "{") {
        i++; ws()
        if (substr(s, i, 1) == "}") { i++; leaf(path, "{}", ""); return }
        while (i <= n) {
            ws()
            if (substr(s, i, 1) != "\"") { fail("invalid JSON"); return }
            k = jstr(); ws()
            if (substr(s, i, 1) != ":") { fail("invalid JSON"); return }
            i++; value(path SUBSEP k); ws()
            c = substr(s, i, 1); i++
            if (c == "}") return
            if (c != ",") { fail("invalid JSON"); return }
        }
        return
    }
    if (c == "[") {
        i++; ws(); idx = 0
        if (substr(s, i, 1) == "]") { i++; leaf(path, "[]", ""); return }
        while (i <= n) {
            value(path SUBSEP "#" idx++); ws()
            c = substr(s, i, 1); i++
            if (c == "]") return
            if (c != ",") { fail("invalid JSON"); return }
        }
        return
    }
    if (c == "\"") { leaf(path, "s", jstr()); return }
    lit = ""
    while (i <= n && index("abcdefghijklmnopqrstuvwxyz0123456789.+-E", substr(s, i, 1)) > 0) { lit = lit substr(s, i, 1); i++ }
    if (lit == "") { fail("invalid JSON"); return }
    leaf(path, "l", lit)
}
function leaf(path, type, v,   m, p, k, name) {
    m = split(substr(path, 2), p, SUBSEP)
    if (m == 0 || (m == 1 && type == "{}")) return
    if (v ~ /[\t\n]/) { fail("a value with a tab or newline"); return }
    if (p[1] == "TCP" && m == 3 && p[2] ~ /^[0-9]+$/) {
        if ((p[3] == "HTTPS" || p[3] == "HTTP") && type == "l" && (v == "true" || v == "false")) {
            if (v == "true") lines = lines "T\t" p[2] "\t" p[3] "\ttrue\n"
            return
        }
        if ((p[3] == "TCPForward" || p[3] == "TerminateTLS") && type == "s") {
            lines = lines "T\t" p[2] "\t" p[3] "\t" v "\n"; return
        }
    }
    if (p[1] == "Web" && m == 5 && p[3] == "Handlers" && (p[5] == "Path" || p[5] == "Proxy" || p[5] == "Text") && type == "s") {
        lines = lines "W\t" p[2] "\t" p[4] "\t" p[5] "\t" v "\n"; return
    }
    if (p[1] == "AllowFunnel" && m == 2 && type == "l" && (v == "true" || v == "false")) {
        lines = lines "F\t" p[2] "\t" v "\n"; return
    }
    name = p[1]
    for (k = 2; k <= m; k++) name = name "." p[k]
    fail(name)
}
{ s = s $0 "\n" }
END {
    n = length(s); i = 1
    value("")
    ws()
    if (bad == "" && i <= n) bad = "invalid JSON"
    if (bad != "") print "!" bad
    printf "%s", lines
}'

# The table → serve.json as Go marshals the ServeConfig (MarshalIndent, two spaces; map keys
# sorted as strings; empty maps omitted; `{}` when nothing is left)
SERVE_PRINT='
function esc(v,   o, c, k) {
    o = ""
    for (k = 1; k <= length(v); k++) {
        c = substr(v, k, 1)
        if (c == "\"") o = o "\\\""; else if (c == "\\") o = o "\\\\"
        else if (c == "<") o = o "\\u003c"; else if (c == ">") o = o "\\u003e"; else if (c == "&") o = o "\\u0026"
        else o = o c
    }
    return "\"" o "\""
}
function add(list, item) { return list == "" ? item : list SUBSEP item }
function sorted(list, arr,   m, a, b, t) {
    m = split(list, arr, SUBSEP)
    for (a = 2; a <= m; a++) { t = arr[a]; for (b = a - 1; b >= 1 && (arr[b] "") > (t ""); b--) arr[b + 1] = arr[b]; arr[b + 1] = t }
    return m
}
BEGIN { FS = "\t" }
$1 == "T" { if (!($2 in tport)) { tport[$2] = 1; tlist = add(tlist, $2) } tf[$2, $3] = $4 }
$1 == "W" {
    if (!($2 in whost)) { whost[$2] = 1; wlist = add(wlist, $2) }
    if (!(($2, $3) in wmount)) { wmount[$2, $3] = 1; mlist[$2] = add(mlist[$2], $3) }
    wk[$2, $3] = $4; wv[$2, $3] = $5
}
$1 == "F" { if (!($2 in fhost)) { fhost[$2] = 1; flist = add(flist, $2) } fv[$2] = $3 }
END {
    out = ""
    if (tlist != "") {
        sec = "  \"TCP\": {\n"
        m = sorted(tlist, ports)
        for (a = 1; a <= m; a++) {
            p = ports[a]; body = ""
            if (tf[p, "HTTPS"] == "true") body = body (body == "" ? "" : ",\n") "      \"HTTPS\": true"
            if (tf[p, "HTTP"] == "true") body = body (body == "" ? "" : ",\n") "      \"HTTP\": true"
            if (tf[p, "TCPForward"] != "") body = body (body == "" ? "" : ",\n") "      \"TCPForward\": " esc(tf[p, "TCPForward"])
            if (tf[p, "TerminateTLS"] != "") body = body (body == "" ? "" : ",\n") "      \"TerminateTLS\": " esc(tf[p, "TerminateTLS"])
            sec = sec "    \"" p "\": " (body == "" ? "{}" : "{\n" body "\n    }") (a < m ? "," : "") "\n"
        }
        out = out (out == "" ? "" : ",\n") sec "  }"
    }
    if (wlist != "") {
        sec = "  \"Web\": {\n"
        m = sorted(wlist, hosts)
        for (a = 1; a <= m; a++) {
            h = hosts[a]
            sec = sec "    " esc(h) ": {\n      \"Handlers\": {\n"
            mm = sorted(mlist[h], mounts)
            for (b = 1; b <= mm; b++) {
                sec = sec "        " esc(mounts[b]) ": {\n          \"" wk[h, mounts[b]] "\": " esc(wv[h, mounts[b]]) "\n        }" (b < mm ? "," : "") "\n"
            }
            sec = sec "      }\n    }" (a < m ? "," : "") "\n"
        }
        out = out (out == "" ? "" : ",\n") sec "  }"
    }
    if (flist != "") {
        sec = "  \"AllowFunnel\": {\n"
        m = sorted(flist, fh)
        for (a = 1; a <= m; a++) sec = sec "    " esc(fh[a]) ": " fv[fh[a]] (a < m ? "," : "") "\n"
        out = out (out == "" ? "" : ",\n") sec "  }"
    }
    if (out == "") print "{}"
    else print "{\n" out "\n}"
}'

serve_table() { [ -f "$SERVE_JSON" ] && awk "$SERVE_PARSE" "$SERVE_JSON"; return 0; }
serve_save() { # the table on stdin → serve.json (a temp file renamed, as the daemon replaces it)
    awk "$SERVE_PRINT" > "$SERVE_JSON.new"
    mv "$SERVE_JSON.new" "$SERVE_JSON"
}
# Edits of $table (one awk over it, -v name=value pairs first)
tab_edit() { table=$(printf '%s\n' "$table" | awk -F '\t' -v OFS='\t' "$@" | grep -v '^$' || true); }
tab_has() { printf '%s\n' "$table" | awk -F '\t' "$@" | grep -q .; }

# Status fields (st: the status JSON, read once per command)
st_field() { printf '%s\n' "$st" | sed -n "s/^  \"$1\": \"\\(.*\\)\",\$/\\1/p" | head -n 1; }
self_dns() { printf '%s\n' "$st" | sed -n 's/^    "DNSName": "\(.*\)",$/\1/p' | head -n 1 | sed 's/\.$//'; }
self_caps() {
    printf '%s\n' "$st" | awk '
        !done && /^    "CapMap": \{/ { on = 1; if ($0 ~ /\}/) exit; next }
        on && /^    \}/ { exit }
        on && /^      "/ { line = $0; sub(/^      "/, "", line); sub(/".*/, "", line); print line }'
}
has_cap() { self_caps | grep -qxF "$1"; }
status_ips() { printf '%s\n' "$st" | awk '/^  "TailscaleIPs": \[/ { on = 1; next } on && /^  \]/ { exit } on { gsub(/[ ",]/, ""); print }' | paste -sd , -; }
cert_domains() {
    printf '%s\n' "$st" | awk '/^  "CertDomains": \[/ { on = 1; next } on && /^  \]/ { exit } on { gsub(/^ *"|",? *$/, ""); print }'
}

# getLocalClientStatusWithoutPeers: anything but Running or Starting ends the CLI (status.go's
# isRunningOrStarting texts)
need_running() {
    state=$(st_field BackendState)
    case $state in
        Running | Starting) return 0 ;;
        Stopped) echo "Tailscale is stopped." >&2 ;;
        NeedsLogin)
            auth=$(st_field AuthURL)
            echo "Logged out." >&2
            [ -n "$auth" ] && echo "Log in at: $auth" >&2 ;;
        NeedsMachineAuth) echo "Machine is not yet approved by tailnet admin." >&2 ;;
        *) echo "unexpected state: $state" >&2 ;;
    esac
    exit 1
}

# The CLI's two failure shapes of runServeCombined: "error: <err>" and the help hint, or a
# plain error (main prints it); both exit 1
help_hint() { printf 'try `tailscale %s --help` for usage info\n' "$command" >&2; exit 1; }
serve_fail() { printf 'error: %s\n\n' "$1" >&2; help_hint; }

# filepath.Clean / path.Clean for absolute paths
clean_path() {
    printf '%s\n' "$1" | awk '{
        n = split($0, part, "/"); depth = 0
        for (k = 1; k <= n; k++) {
            if (part[k] == "" || part[k] == ".") continue
            if (part[k] == "..") { if (depth > 0) depth--; continue }
            keep[++depth] = part[k]
        }
        out = ""
        for (k = 1; k <= depth; k++) out = out "/" keep[k]
        print (out == "" ? "/" : out) }'
}

is_port() { # a decimal that strconv.ParseUint(…, 10, 16) takes
    case $1 in "" | *[!0-9]*) return 1 ;; esac
    [ "${#1}" -le 5 ] && [ "$(printf '%s' "$1" | sed 's/^0*//; s/^$/0/')" -le 65535 ]
}
port_number() { printf '%s' "$1" | sed 's/^0*//; s/^$/0/'; }

# ipn.ExpandProxyTargetValue for the targets the module uses: prints the target or the error
# (status 1)
expand_target() { # <target> <supported schemes, space-separated> <default scheme>
    target=$1
    [ -n "$target" ] || { echo "empty target"; return 1; }
    if is_port "$target"; then echo "$3://127.0.0.1:$(port_number "$target")"; return 0; fi
    has_scheme=true
    case $target in
        *://*) ;;
        *) target="$3://$target"; has_scheme=false ;;
    esac
    scheme=$(printf '%s' "${target%%://*}" | tr '[:upper:]' '[:lower:]')
    rest=${target#*://}
    hostport=${rest%%/*}
    tail=${rest#"$hostport"}
    case " $2 " in
        *" $scheme "*) ;;
        *) echo "must be a URL starting with one of the supported schemes: [$2]"; return 1 ;;
    esac
    case $hostport in
        \[*\]:*) host=${hostport%%]*}; host=${host#[}; port=${hostport##*]:} ;;
        \[*\]) host=${hostport#[}; host=${host%]}; port="" ;;
        *:*) host=${hostport%:*}; port=${hostport##*:} ;;
        *) host=$hostport; port="" ;;
    esac
    case $host in
        localhost | 127.0.0.1 | ::1)
            [ -n "$port" ] || { printf 'port required for localhost target "%s"\n' "$target"; return 1; } ;;
        *)
            printf '%s' "$host" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$|^[0-9a-fA-F:.]+$' \
                || { printf 'invalid hostname or IP address "%s"\n' "$host"; return 1; }
            $has_scheme || { printf 'non-localhost target "%s" must include a scheme\n' "$target"; return 1; } ;;
    esac
    if [ -z "$port" ]; then echo "$scheme://$hostport$tail"; return 0; fi
    { is_port "$port" && [ "$(port_number "$port")" != 0 ]; } || { printf 'invalid port "%s"\n' "$port"; return 1; }
    case $host in *:*) host="[$host]" ;; esac
    echo "$scheme://$host:$(port_number "$port")$tail"
}

# messageForPort: what a successful `serve`/`funnel` prints (stdout)
serve_message() { # <port> <the flag's type: https|http|tcp|tls-terminated-tcp>
    printf '%s\n' "$table" | awk -F '\t' -v port="$1" -v stype="$2" -v host="$host" -v hp="$host:$1" \
        -v cmd="$command" -v ips="$(status_ips)" '
        $1 == "T" && $2 == port { t[$3] = $4; has_t = 1 }
        $1 == "W" && $2 == hp { if (!($3 in seen)) { seen[$3] = 1; mounts[++nm] = $3 } wk[$3] = $4; wv[$3] = $5 }
        $1 == "F" && $2 == hp { funnel = $3 }
        END {
            scheme = t["HTTP"] == "true" ? "http" : "https"
            pp = ":" port
            if ((scheme == "http" && port == 80) || (scheme == "https" && port == 443)) pp = ""
            out = (funnel == "true" ? "Available on the internet:" : "Available within your tailnet:") "\n\n"
            for (a = 2; a <= nm; a++) { m = mounts[a]
                for (b = a - 1; b >= 1 && (length(mounts[b]) > length(m) || (length(mounts[b]) == length(m) && mounts[b] > m)); b--) mounts[b + 1] = mounts[b]
                mounts[b + 1] = m }
            if (nm > 0) {
                for (a = 1; a <= nm; a++) {
                    m = mounts[a]; k = wk[m]; d = wv[m]
                    kind = k == "Path" ? "path" : (k == "Proxy" ? "proxy" : "text")
                    if (k == "Text") d = "\"" (length(d) <= 20 ? d : substr(d, 1, 17) "...") "\""
                    out = out scheme "://" host pp m "\n" sprintf("|-- %-5s %s\n\n", kind, d)
                }
            } else if (has_t) {
                out = out "|-- tcp://" host ":" port (t["TerminateTLS"] != "" ? " (TLS terminated)" : "") "\n"
                n = split(ips, ip, ",")
                for (a = 1; a <= n; a++) out = out "|-- tcp://" (ip[a] ~ /:/ ? "[" ip[a] "]" : ip[a]) ":" port "\n"
                out = out "|--> tcp://" t["TCPForward"] "\n\n"
            }
            out = out toupper(substr(cmd, 1, 1)) substr(cmd, 2) " started and running in the background.\n"
            out = out "To disable the proxy, run: tailscale " cmd " --" stype "=" port " off"
            print out
        }'
}

# `serve status` / `funnel status` without --json (runServeStatus: printFunnelStatus, then the
# trees)
serve_status_text() {
    if printf '%s\n' "$table" | grep -q '^!'; then
        echo "# stand-in: the text status of this serve.json is not replayed (--json is)"
        return 0
    fi
    printf '%s\n' "$table" | awk -F '\t' -v host="$host" -v ips="$(status_ips)" '
        function add(list, item) { return list == "" ? item : list SUBSEP item }
        function sorted(list, arr, numeric,   m, a, b, t) {
            m = split(list, arr, SUBSEP)
            for (a = 2; a <= m; a++) { t = arr[a]
                for (b = a - 1; b >= 1 && (numeric ? arr[b] + 0 > t + 0 : (arr[b] "") > (t "")); b--) arr[b + 1] = arr[b]
                arr[b + 1] = t }
            return m
        }
        $1 == "T" { if (!($2 in tport)) { tport[$2] = 1; tlist = add(tlist, $2) } tf[$2, $3] = $4 }
        $1 == "W" { if (!($2 in whost)) { whost[$2] = 1; wlist = add(wlist, $2) }
                    if (!(($2, $3) in wm)) { wm[$2, $3] = 1; mlist[$2] = add(mlist[$2], $3) }
                    wk[$2, $3] = $4; wv[$2, $3] = $5 }
        $1 == "F" { if (!($2 in fhost)) { fhost[$2] = 1; flist = add(flist, $2) } fv[$2] = $3; if ($3 == "true") funnel_on = 1 }
        END {
            if (funnel_on) {
                printf "\n# Funnel on:\n"
                m = sorted(flist, fh, 0)
                for (a = 1; a <= m; a++) { if (fv[fh[a]] != "true") continue
                    p = fh[a]; sub(/.*:/, "", p); sni = fh[a]; sub(/:[0-9]+$/, "", sni)
                    is_tcp = (p in tport) && tf[p, "HTTPS"] != "true" && tf[p, "HTTP"] != "true"
                    printf "#     - %s%s%s\n", (is_tcp ? "tcp://" : "https://"), sni, (is_tcp || p != 443 ? ":" p : "") }
                printf "\n"
            }
            if (tlist == "" && wlist == "" && flist == "") { print "No serve config"; exit }
            n = split(ips, ip, ","); any_tcp = 0
            m = sorted(tlist, ports, 1)
            for (a = 1; a <= m; a++) { p = ports[a]; if (tf[p, "TCPForward"] == "") continue
                any_tcp = 1; hp = host ":" p; fs = fv[hp] == "true" ? "Funnel on" : "tailnet only"
                if (tf[p, "TerminateTLS"] != "") printf "|-- tcp://%s (TLS-terminated TCP, %s)\n", hp, fs
                else printf "|-- tcp://%s (%s)\n", hp, fs
                for (b = 1; b <= n; b++) printf "|-- tcp://%s:%s\n", (ip[b] ~ /:/ ? "[" ip[b] "]" : ip[b]), p
                printf "|--> tcp://%s\n", tf[p, "TCPForward"] }
            if (any_tcp) printf "\n"
            m = sorted(wlist, hosts, 0)
            for (a = 1; a <= m; a++) { hp = hosts[a]; p = hp; sub(/.*:/, "", p); h = hp; sub(/:[0-9]+$/, "", h)
                scheme = tf[p, "HTTP"] == "true" ? "http" : "https"
                pp = ((scheme == "http" && p == 80) || (scheme == "https" && p == 443)) ? "" : ":" p
                fs = fv[hp] == "true" ? "Funnel on" : "tailnet only"
                if (scheme == "http") { short = h; sub(/\..*/, "", short); printf "%s://%s%s (%s)\n", scheme, short, pp, fs }
                printf "%s://%s%s (%s)\n", scheme, h, pp, fs
                mm = split(mlist[hp], mounts, SUBSEP)
                for (b = 2; b <= mm; b++) { t = mounts[b]
                    for (c = b - 1; c >= 1 && length(mounts[c]) > length(t); c--) mounts[c + 1] = mounts[c]
                    mounts[c + 1] = t }
                max = length(mounts[mm])
                for (b = 1; b <= mm; b++) { k = wk[hp, mounts[b]]; d = wv[hp, mounts[b]]
                    kind = k == "Path" ? "path" : (k == "Proxy" ? "proxy" : "text")
                    if (k == "Text") d = "\"" (length(d) <= 20 ? d : substr(d, 1, 17) "...") "\""
                    pad = sprintf("%" (max - length(mounts[b]) + 0) "s", "")
                    if (max == length(mounts[b])) pad = ""
                    printf "|-- %s%s %-5s %s\n", mounts[b], pad, kind, d }
                printf "\n" }
        }'
}

serve_usage() {
    printf 'USAGE\n  tailscale %s <target>\n  tailscale %s status [--json]\n  tailscale %s reset\n' "$command" "$command" "$command" >&2
    exit 0
}

# `serve|funnel <flags> <target>|off` (runServeCombined)
serve_set() {
    bg=false yes=false https=0 http=0 tcp=0 tlstcp=0 set_path="" set_path_given=false
    while [ $# -gt 0 ]; do
        case $1 in --*) option=${1#--} ;; -?*) option=${1#-} ;; *) break ;; esac
        [ "$option" = "" ] && { shift; break; } # "--": the end of the flags
        name=${option%%=*}
        case $option in *=*) value=${option#*=} ;; *) value="" ;; esac
        case $name in
            bg | yes)
                if [ "$option" = "$name" ]; then value=true; fi
                case $value in
                    1 | t | T | true | TRUE | True) value=true ;;
                    0 | f | F | false | FALSE | False) value=false ;;
                    *) printf 'invalid boolean value "%s" for -%s: parse error\n' "$value" "$name" >&2; exit 2 ;;
                esac
                if [ "$name" = bg ]; then bg=$value; else yes=$value; fi ;;
            https | http | tcp | tls-terminated-tcp | set-path)
                if [ "$option" = "$name" ]; then
                    [ $# -ge 2 ] || { printf 'flag needs an argument: -%s\n' "$name" >&2; exit 2; }
                    value=$2
                    shift
                fi
                [ "$name" = http ] && [ "$command" = funnel ] && { printf 'flag provided but not defined: -%s\n' "$name" >&2; exit 2; }
                if [ "$name" = set-path ]; then
                    set_path=$value
                    set_path_given=true
                else
                    case $value in "" | *[!0-9]*) printf 'invalid value "%s" for flag -%s: parse error\n' "$value" "$name" >&2; exit 2 ;; esac
                    value=$(port_number "$value")
                    case $name in
                        https) https=$value ;;
                        http) http=$value ;;
                        tcp) tcp=$value ;;
                        tls-terminated-tcp) tlstcp=$value ;;
                    esac
                fi ;;
            service | tun | accept-app-caps | proxy-protocol)
                if [ "$name" = tun ] || [ "$command" = serve ] || [ "$name" = proxy-protocol ]; then
                    printf 'stand-in: %s --%s not replayed\n' "$command" "$name" >&2
                    exit 2
                fi
                printf 'flag provided but not defined: -%s\n' "$name" >&2; exit 2 ;;
            *) printf 'flag provided but not defined: -%s\n' "$name" >&2; exit 2 ;;
        esac
        shift
    done
    # validateArgs
    [ $# -eq 0 ] && serve_usage
    if [ $# -gt 2 ]; then printf 'Error: invalid number of arguments (%d)\n' "$#" >&2; help_hint; fi
    last=""
    for argument in "$@"; do last=$argument; done
    turn_off=false
    [ "$last" = off ] && turn_off=true
    if [ $# -eq 2 ] && [ $turn_off = false ]; then echo "Error: invalid argument format" >&2; help_hint; fi
    target=$1

    st=$(print_status)
    if [ "$command" = funnel ]; then
        # verifyFunnelEnabled (its status first: not running ends it), then CheckFunnelAccess —
        # for port 443, whatever port was asked (as the real CLI)
        need_running
        has_cap https || { echo "Funnel not available; HTTPS must be enabled. See https://tailscale.com/s/https." >&2; exit 1; }
        has_cap funnel || { echo 'Funnel not available; "funnel" node attribute not set. See https://tailscale.com/s/no-funnel.' >&2; exit 1; }
        ports_cap=$(self_caps | grep '^https://tailscale.com/cap/funnel-ports' | head -n 1 || true)
        allowed=""
        case $ports_cap in "https://tailscale.com/cap/funnel-ports?ports="?*) allowed=${ports_cap#*\?ports=} ;; esac
        port_ok=false
        old_ifs=$IFS
        IFS=,
        for range in $allowed; do
            case $range in
                *-*) first=${range%%-*}; end=${range#*-}
                     is_port "$first" && is_port "$end" && [ "$first" -le 443 ] && [ "$end" -ge 443 ] && port_ok=true ;;
                443) port_ok=true ;;
            esac
        done
        IFS=$old_ifs
        if [ $port_ok = false ]; then
            if [ -n "$allowed" ]; then echo "port 443 is not allowed for funnel; allowed ports are: $allowed" >&2
            else echo "port 443 is not allowed for funnel" >&2; fi
            exit 1
        fi
    fi
    # cleanURLPath
    mount=/
    if [ -n "$set_path" ]; then
        case $set_path in /*) mount=$set_path ;; *) mount=/$set_path ;; esac
        cleaned=$(clean_path "$mount")
        if [ "$mount" != "$cleaned" ] && [ "$mount" != "$cleaned/" ]; then
            printf 'failed to clean the mount point: invalid mount point "%s"\n' "$mount" >&2
            exit 1
        fi
    fi
    # srvTypeAndPortFromFlags
    count=0 stype=https port=443
    for pair in "http $http" "https $https" "tcp $tcp" "tls-terminated-tcp $tlstcp"; do
        # shellcheck disable=SC2086 # split on purpose: "<type> <port>"
        set -- $pair
        if [ "$2" != 0 ]; then
            [ "$2" -gt 65535 ] && serve_fail "port number $2 is too high for https flag"
            count=$((count + 1)) stype=$1 port=$2
        fi
    done
    [ $count -gt 1 ] && serve_fail "cannot serve multiple types for a single mount point"
    # serve-next.json: another client's change landing between the module's plan and this
    # `funnel` run as root (the password dialog's time): it becomes the config this run reads
    if [ "$command" = funnel ] && [ "${TS_FAKE_ROOT:-0}" = 1 ] && [ -f "$STATE_DIR/serve-next.json" ]; then
        mv "$STATE_DIR/serve-next.json" "$SERVE_JSON"
    fi
    table=$(serve_table)
    need_running
    host=$(self_dns)
    hp=$host:$port
    # enableFeatureInteractive("serve", https): without the capability control answers with a
    # text and a link and the CLI exits 0, changing nothing (the not-waiting path)
    if [ $turn_off = false ] && [ "$stype" = https ] && ! has_cap https; then
        printf '\nServe is not enabled on your tailnet.\nTo enable, visit:\n\n         https://login.tailscale.com/f/serve?node=REDACTED\n\n'
        exit 0
    fi
    if [ $bg = false ] && [ $turn_off = false ]; then
        echo "stand-in: foreground $command not replayed (the module always passes --bg)" >&2
        exit 2
    fi
    if printf '%s\n' "$table" | grep -q '^!'; then
        printf 'stand-in: serve.json holds %s, not replayed; changes not replayed\n' "$(printf '%s\n' "$table" | sed -n 's/^!//p')" >&2
        exit 2
    fi
    msg=""
    case $stype in
        https | http)
            if [ $turn_off = true ]; then
                # removeWebServe
                if tab_has -v p="$port" '$1 == "T" && $2 == p' && ! tab_has -v p="$port" '$1 == "T" && $2 == p && ($3 == "HTTPS" || $3 == "HTTP")'; then
                    serve_fail "failed to remove web serve: cannot remove web handler; currently serving TCP"
                fi
                if [ $set_path_given = true ]; then
                    tab_has -v hp="$hp" -v m="$mount" '$1 == "W" && $2 == hp && $3 == m' \
                        || serve_fail "failed to remove web serve: handler does not exist"
                    remove_mount=$mount
                else
                    tab_has -v hp="$hp" '$1 == "W" && $2 == hp' || serve_fail "failed to remove web serve: handler does not exist"
                    remove_mount=""
                    mounts=$(printf '%s\n' "$table" | awk -F '\t' -v hp="$hp" '$1 == "W" && $2 == hp && !seen[$3]++' | wc -l | tr -d ' ')
                    if [ "$mounts" -gt 1 ] && [ $yes = false ] && [ -t 0 ] && [ -t 1 ]; then
                        # prompt.YesNo(…, true): asked only on a terminal (else: yes)
                        printf 'Are you sure you want to delete %s handlers under port %s? [Y/n] ' "$mounts" "$port"
                        read -r answer || answer=""
                        case $(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]') in
                            "" | y | yes | sure) ;;
                            *) remove_mount="-" ;;
                        esac
                    fi
                fi
                if [ "$remove_mount" != "-" ]; then
                    # RemoveWebHandler(…, cleanupFunnel): the last mount takes the listener and Funnel
                    tab_edit -v hp="$hp" -v m="$remove_mount" '!($1 == "W" && $2 == hp && (m == "" || $3 == m))'
                    if ! tab_has -v hp="$hp" '$1 == "W" && $2 == hp'; then
                        tab_edit -v hp="$hp" -v p="$port" '!($1 == "T" && $2 == p) && !($1 == "F" && $2 == hp)'
                    fi
                fi
            else
                # applyWebServe
                case $target in
                    text:*)
                        kind=Text value=${target#text:}
                        [ -n "$value" ] || serve_fail "failed apply web serve: unable to serve; text cannot be an empty string" ;;
                    /*)
                        kind=Path value=$(clean_path "$target")
                        [ -e "$value" ] || serve_fail "failed apply web serve: invalid path"
                        if [ -d "$value" ]; then case $mount in */) ;; *) mount=$mount/ ;; esac; fi ;;
                    unix:*) echo "stand-in: unix: targets not replayed" >&2; exit 2 ;;
                    *)
                        kind=Proxy
                        value=$(expand_target "$target" "http https https+insecure unix" http) \
                            || serve_fail "failed apply web serve: $value" ;;
                esac
                if tab_has -v p="$port" '$1 == "T" && $2 == p' && ! tab_has -v p="$port" '$1 == "T" && $2 == p && ($3 == "HTTPS" || $3 == "HTTP")'; then
                    serve_fail "failed apply web serve: cannot serve web; already serving TCP"
                fi
                [ "$stype" = https ] && listener=HTTPS || listener=HTTP
                # SetWebHandler: the listener replaced, the mount (and its twin with or without
                # the trailing slash) replaced
                tab_edit -v p="$port" -v hp="$hp" -v m="$mount" '
                    function trim(x) { sub(/\/$/, "", x); return x }
                    !($1 == "T" && $2 == p) && !($1 == "W" && $2 == hp && trim($3) == trim(m))'
                table=$(printf '%s\nT\t%s\t%s\ttrue\nW\t%s\t%s\t%s\t%s' "$table" "$port" "$listener" "$hp" "$mount" "$kind" "$value" | grep -v '^$')
            fi ;;
        tcp | tls-terminated-tcp)
            if [ $turn_off = true ]; then
                tab_has -v p="$port" '$1 == "T" && $2 == p' || serve_fail "failed to remove TCP serve: serve config does not exist"
                if tab_has -v p="$port" '$1 == "T" && $2 == p && ($3 == "HTTPS" || $3 == "HTTP")'; then
                    serve_fail "failed to remove TCP serve: unable to remove; serving web, not TCP forwarding on serve port $port"
                fi
                tab_edit -v p="$port" '!($1 == "T" && $2 == p)'
            else
                [ -n "$set_path" ] && { printf 'error: cannot mount a path for TCP serve\n\n' >&2; help_hint; }
                case $target in unix:*) echo "stand-in: unix: targets not replayed" >&2; exit 2 ;; esac
                url=$(expand_target "$target" "tcp unix" tcp) || serve_fail "failed to apply TCP serve: unable to expand target: $url"
                forward=${url#tcp://}
                forward=${forward%%/*}
                case $forward in
                    *\]:* | [!\[]*:*) ;;
                    *) serve_fail "failed to apply TCP serve: TCP target \"$target\" must include a port" ;;
                esac
                if tab_has -v p="$port" '$1 == "T" && $2 == p && ($3 == "HTTPS" || $3 == "HTTP")'; then
                    serve_fail "failed to apply TCP serve: cannot serve TCP; already serving web on $port for $host"
                fi
                tab_edit -v p="$port" '!($1 == "T" && $2 == p)'
                table=$(printf '%s\nT\t%s\tTCPForward\t%s' "$table" "$port" "$forward" | grep -v '^$')
                [ "$stype" = tls-terminated-tcp ] && table=$(printf '%s\nT\t%s\tTerminateTLS\t%s' "$table" "$port" "$host")
            fi ;;
    esac
    if [ $turn_off = false ]; then
        # applyFunnel: `funnel` turns it on for host:port, `serve` takes it away
        if [ "$command" = funnel ]; then
            tab_edit -v hp="$hp" '!($1 == "F" && $2 == hp)'
            table=$(printf '%s\nF\t%s\ttrue' "$table" "$hp" | grep -v '^$')
        elif tab_has -v hp="$hp" '$1 == "F" && $2 == hp'; then
            printf 'Removing Funnel for %s:%s\n' "$host" "$hp" >&2
            tab_edit -v hp="$hp" '!($1 == "F" && $2 == hp)'
        fi
        msg=$(serve_message "$port" "$stype")
    fi
    serve_commit
    # serve-fail-after-write: this `funnel` run as root fails after its config was written (as
    # one ended by its time limit after the daemon took the change)
    if [ "$command" = funnel ] && [ "${TS_FAKE_ROOT:-0}" = 1 ] && [ -f "$STATE_DIR/serve-fail-after-write" ]; then
        rm -f "$STATE_DIR/serve-fail-after-write"
        echo "stand-in: stopped after the config was written" >&2
        exit 1
    fi
    [ -n "$msg" ] && printf '%s\n' "$msg"
    return 0
}

# SetServeConfig: the LocalAPI's checks (write access, root for a Path handler), the daemon's
# (no Funnel under shields-up), then the config replaced. The CLI wraps each error in
# "sending serve config: "
serve_commit() {
    deny_prefix="sending serve config: "
    need_write "serve config denied" "$serve_argv"
    if [ "${TS_FAKE_ROOT:-0}" != 1 ] && tab_has '$1 == "W" && $4 == "Path"'; then
        echo "sending serve config: 401 Unauthorized: must be root, or be an operator and able to run 'sudo tailscale' to serve a path or Unix socket" >&2
        exit 1
    fi
    # (prefs_value leaves the comma of a non-string value)
    if tab_has '$1 == "F" && $3 == "true"' && [ "$(prefs_value ShieldsUp | sed 's/,$//')" = true ]; then
        echo "sending serve config: updating config: Unable to turn on Funnel while shields-up is enabled" >&2
        exit 1
    fi
    printf '%s\n' "$table" | serve_save
}

serve_command() {
    serve_argv="$command $*"
    case ${1:-} in
        status)
            shift
            json=false
            for argument in "$@"; do
                case $argument in
                    --json | -json | --json=true | --json=1) json=true ;;
                    --json=false | --json=0) json=false ;;
                    *) printf 'flag provided but not defined: -%s\n' "${argument#--}" >&2; exit 2 ;;
                esac
            done
            if [ $json = true ]; then
                if [ -f "$SERVE_JSON" ]; then cat "$SERVE_JSON"; else echo "{}"; fi
            else
                table=$(serve_table)
                st=$(print_status)
                host=$(self_dns)
                serve_status_text
            fi ;;
        reset)
            shift
            [ $# -eq 0 ] || { printf 'USAGE\n  tailscale %s reset\n' "$command" >&2; exit 0; }
            table=""
            serve_commit
            ;;
        drain | clear | advertise | get-config | set-config)
            [ "$command" = serve ] || { serve_set "$@"; return; }
            echo "stand-in: serve $1 not replayed" >&2
            exit 2 ;;
        *) serve_set "$@" ;;
    esac
}

# ---- cert (step 5) ----

# atomicfile.WriteFile: a temp file in the same directory (created 0600), the mode set, renamed
write_if_changed() { # <file> <contents> <mode> → "changed" / "unchanged", or fails like Go
    [ "$1" = - ] && { echo unchanged; return 0; } # the caller prints it
    if [ -f "$1" ] && [ "$(cat "$1"; printf x)" = "$2x" ]; then echo unchanged; return 0; fi
    dir=$(dirname "$1")
    base=$(basename "$1")
    tmp=$( (umask 077 && mktemp "$dir/$base.tmp.XXXXXX") 2> /dev/null) \
        || { printf 'open %s: no such file or directory\n' "$1" >&2; return 1; }
    if ! { printf "%s" "$2" > "$tmp" && chmod "$3" "$tmp" && mv -f "$tmp" "$1"; }; then rm -f "$tmp"; return 1; fi
    echo changed
}

cert_command() {
    cert_file="" key_file="" cert_given=false key_given=false
    while [ $# -gt 0 ]; do
        case $1 in
            --cert-file=* | -cert-file=*) cert_file=${1#*=}; cert_given=true ;;
            --key-file=* | -key-file=*) key_file=${1#*=}; key_given=true ;;
            --min-validity=* | -min-validity=*)
                printf '%s' "${1#*=}" | grep -Eq '^([0-9]+(\.[0-9]+)?(ns|us|ms|s|m|h))+$|^0$' \
                    || { printf 'invalid value "%s" for flag -min-validity: parse error\n' "${1#*=}" >&2; exit 2; } ;;
            --serve-demo* | -serve-demo*) echo "stand-in: cert --serve-demo not replayed" >&2; exit 2 ;;
            --) shift; break ;;
            -*) name=${1#-}; name=${name#-}; printf 'flag provided but not defined: -%s\n' "${name%%=*}" >&2; exit 2 ;;
            *) break ;;
        esac
        shift
    done
    st=$(print_status)
    if [ $# -ne 1 ]; then
        domains=$(cert_domains)
        if [ "$(st_field BackendState)" != Running ]; then hint="Tailscale is not running."
        elif [ -z "$domains" ]; then hint="HTTPS cert support is not enabled/configured for your tailnet."
        elif [ "$(printf '%s\n' "$domains" | wc -l)" -eq 1 ]; then hint="For domain, use \"$domains\"."
        else hint="Valid domain options: [$(printf '%s\n' "$domains" | sed 's/.*/"&"/' | paste -sd ' ' -)]."; fi
        printf 'Usage: tailscale cert [flags] <domain>\n%s\n' "$hint" >&2
        exit 1
    fi
    domain=${1%.}
    if [ $cert_given = false ] && [ $key_given = false ]; then
        base=$(printf '%s' "$domain" | sed 's/^\*\./wildcard_./')
        cert_file=$base.crt
        key_file=$base.key
    fi
    need_write "cert access denied" cert "$@"
    domains=$(cert_domains)
    [ -n "$domains" ] || { echo "500 Internal Server Error: your Tailscale account does not support getting TLS certs" >&2; exit 1; }
    case $domain in
        \*.*) echo "500 Internal Server Error: wildcard certificates are not enabled for this node" >&2; exit 1 ;;
    esac
    if ! printf '%s\n' "$domains" | grep -qxF "$domain"; then
        printf '500 Internal Server Error: invalid domain "%s"; must be one of [%s]\n' "$domain" \
            "$(printf '%s\n' "$domains" | sed 's/.*/"&"/' | paste -sd ' ' -)" >&2
        exit 1
    fi
    [ "${TS_FAKE_CERT_DELAY:-0}" != 0 ] && pause "$TS_FAKE_CERT_DELAY"
    not_after=${TS_FAKE_CERT_NOT_AFTER:-Feb 14 12:00:00 2027 GMT}
    cert_pem=$(printf -- '-----BEGIN CERTIFICATE-----\nSTAND-IN %s notAfter=%s\n-----END CERTIFICATE-----\nx' "$domain" "$not_after")
    cert_pem=${cert_pem%x}
    key_pem=$(printf -- '-----BEGIN EC PRIVATE KEY-----\nSTAND-IN key for %s\n-----END EC PRIVATE KEY-----\nx' "$domain")
    key_pem=${key_pem%x}
    if [ -n "$cert_file" ]; then
        result=$(write_if_changed "$cert_file" "$cert_pem" 644) || exit 1
        case $cert_file in -) printf '%s' "$cert_pem" ;; esac
        if [ "$cert_file" != - ]; then
            if [ "$result" = changed ]; then echo "Wrote public cert to $cert_file"; else echo "Public cert unchanged at $cert_file"; fi
        fi
    fi
    if [ -n "$key_file" ]; then
        result=$(write_if_changed "$key_file" "$key_pem" 600) || exit 1
        case $key_file in -) printf '%s' "$key_pem" ;; esac
        if [ "$key_file" != - ]; then
            if [ "$result" = changed ]; then echo "Wrote private key to $key_file"; else echo "Private key unchanged at $key_file"; fi
        fi
    fi
}

# ---- lock status (step 5) ----

lock_json() { if [ -f "$STATE_DIR/lock.json" ]; then cat "$STATE_DIR/lock.json"; else cat "$F/lock-disabled.json"; fi; }

# printTailnetLockStatus's text, from the JSON form
lock_text() {
    lock_json | awk '
        function str(line) { sub(/^[^:]*: *"/, "", line); sub(/",? *$/, "", line); return line }
        /^  "Enabled": / { enabled = ($0 ~ /true/) }
        /^  "PublicKey": / { public = str($0) }
        /^  "NodeKey": / { nodekey = str($0) }
        /^  "NodeKeySigned": / { signed = ($0 ~ /true/) }
        /^  "NodeKeySignature": \{/ { in_sig = 1 }
        in_sig && /^    "SigKind": / { sigkind = str($0) }
        in_sig && /^    "KeyID": / { sigkey = str($0) }
        in_sig && /^  \}/ { in_sig = 0 }
        /^  "TrustedKeys": \[/ { section = "trusted"; next }
        /^  "FilteredPeers": \[/ { section = "filtered"; next }
        /^  "[A-Za-z]/ { section = "" }
        section == "trusted" && /^    \{/ { nk++; purpose[nk] = ""; stableid[nk] = "" }
        section == "trusted" && /^      "Votes": / { v = $0; gsub(/[^0-9]/, "", v); votes[nk] = v }
        section == "trusted" && /^      "Public": / { key[nk] = str($0) }
        section == "trusted" && /^        "purpose": / { purpose[nk] = str($0) }
        section == "trusted" && /^        "authkey_stableid": / { stableid[nk] = str($0) }
        section == "filtered" && /^    \{/ { np++; ips[np] = "" }
        section == "filtered" && /^      "ID": / { pid[np] = str($0) }
        section == "filtered" && /^      "DNSName": / { pname[np] = str($0) }
        section == "filtered" && /^      "NodeKey": / { pkey[np] = str($0) }
        section == "filtered" && /^        "/ { ip = $0; gsub(/[ ",]/, "", ip); ips[np] = ips[np] (ips[np] == "" ? "" : ",") ip }
        END {
            print (enabled ? "Tailnet Lock is ENABLED." : "Tailnet Lock is NOT enabled.")
            print ""
            if (enabled && nodekey != "" && public != "") {
                if (signed) {
                    print "This node is accessible under Tailnet Lock. Node signature:"
                    print "SigKind: " sigkind
                    print "KeyID: " sigkey
                } else {
                    print "This node is LOCKED OUT by Tailnet Lock, and action is required to establish connectivity."
                    printf "Run the following command on a node with a trusted key:\n\ttailscale lock sign %s %s\n", nodekey, public
                }
                print ""
            }
            if (public != "") { print "This node'"'"'s tailnet-lock key: " public; print "" }
            if (enabled && nk > 0) {
                print "Trusted signing keys:"
                for (k = 1; k <= nk; k++) {
                    line = "\t" key[k] "\t" votes[k] "\t" (key[k] == public ? "(self)" : "")
                    if (purpose[k] == "pre-auth key") line = line (stableid[k] != "" ? "(pre-auth key " stableid[k] ")" : "(pre-auth key)")
                    print line
                }
            }
            if (enabled && np > 0) {
                print ""
                print "The following nodes are locked out by tailnet lock and cannot connect to other nodes:"
                for (k = 1; k <= np; k++) print "\t" pname[k] "\t" ips[k] "\t" pid[k] "\t" pkey[k]
            }
        }'
}

command=${1:-}
[ $# -gt 0 ] && shift
case $command in
    version)
        case " $* " in
            *" --json "*) cat "$F/version.json" ;;
            *) printf '1.104.4\n  tailscale commit: 0000000000000000000000000000000000000000\n  long version: 1.104.4-stand-in\n' ;;
        esac ;;
    dns)
        need_daemon
        case " $* " in
            *status*--json* | *--json*status*) cat "$F/dns-status.json" ;;
            *) echo "stand-in: only dns status --json is replayed" >&2; exit 2 ;;
        esac ;;
    status)
        need_daemon
        hang=${TS_FAKE_STATUS_HANG:-$(cat "$STATE_DIR/status-hang" 2> /dev/null || echo 0)}
        [ "$hang" != 0 ] && pause "$hang"
        while [ -e "$STATE_DIR/status-hold" ]; do pause 0.1; done
        case " $* " in
            *" --json "* | *" --json=true "*) print_status ;;
            *) echo "# stand-in: only status --json is replayed" ;;
        esac ;;
    ip)
        need_daemon
        printf '100.64.0.1\nfd7a:115c:a1e0::1\n' ;;
    debug)
        need_daemon
        case ${1:-} in
            prefs) print_prefs ;;
            derp-map) cat "$F/derp-map.json" ;;
            watch-ipn)
                while IFS= read -r line; do
                    printf '%s\n' "$line"
                    [ "$line" = "}" ] && [ "${TS_FAKE_BUS_DELAY:-0}" != 0 ] && sleep "$TS_FAKE_BUS_DELAY"
                done < "$F/bus-pretty.txt"
                ;;
            *) echo "stand-in: debug ${1:-} not replayed" >&2; exit 2 ;;
        esac ;;
    exit-node)
        need_daemon
        case ${1:-} in
            list) cat "$F/exit-node-list.txt" ;;
            suggest) cat "$F/exit-node-suggest.txt" ;;
            *) echo "stand-in: exit-node ${1:-} not replayed" >&2; exit 2 ;;
        esac ;;
    switch)
        need_daemon
        need_write "profiles access denied" switch "$@"
        case ${1:-} in
            --list)
                case " $* " in
                    *" --json "*) print_profiles json ;;
                    *) print_profiles ;;
                esac ;;
            remove)
                profile_exists "${2:-}" || { printf 'No profile named "%s"\n' "${2:-}" >&2; exit 1; }
                awk -F '\t' -v id="$2" '$1 != id' "$STATE_DIR/profiles" > "$STATE_DIR/profiles.new"
                mv "$STATE_DIR/profiles.new" "$STATE_DIR/profiles"
                # The one in use removed: an empty profile (the module never asks for that)
                if [ "$(current_profile)" = "$2" ]; then : > "$STATE_DIR/current"; save_scenario needs-login; fi
                ;;
            *)
                profile_exists "${1:-}" || { printf 'No profile named "%s"\n' "${1:-}" >&2; exit 1; }
                if [ "$(current_profile)" = "$1" ]; then
                    printf 'Already on account "%s"\n' "$(profile_field "$1" 4)"
                else
                    # Each profile has its prefs: the old one's kept, the new one's restored
                    save_profile_prefs "$(current_profile)"
                    if [ -f "$STATE_DIR/prefs.$1" ]; then mv "$STATE_DIR/prefs.$1" "$STATE_DIR/prefs"; else : > "$STATE_DIR/prefs"; fi
                    printf '%s\n' "$1" > "$STATE_DIR/current"
                    printf 'Switching to account "%s"\n' "$(profile_field "$1" 4)"
                    # Every account of the stand-in is a logged-in, running one
                    case $scenario in needs-login | login-pending) save_scenario running ;; esac
                fi ;;
        esac ;;
    set)
        need_daemon
        need_write "prefs write access denied" set "$@"
        [ $# -gt 0 ] || { echo "usage: tailscale set [flags]" >&2; exit 2; }
        # All or nothing, as the real `set` (one EditPrefs): the checks first, then the writes
        set_checks "$@"
        for argument in "$@"; do
            case $argument in
                --accept-routes | --accept-routes=*) bool_pref RouteAll "$argument" ;;
                --accept-dns | --accept-dns=*) bool_pref CorpDNS "$argument" ;;
                --shields-up | --shields-up=*) bool_pref ShieldsUp "$argument" ;;
                --exit-node-allow-lan-access | --exit-node-allow-lan-access=*) bool_pref ExitNodeAllowLANAccess "$argument" ;;
                --ssh | --ssh=*) bool_pref RunSSH "$argument" ;;
                --webclient | --webclient=*) bool_pref RunWebClient "$argument" ;;
                --update-check | --update-check=*) bool_pref UpdateCheck "$argument" ;;
                --auto-update | --auto-update=*) bool_pref AutoUpdateApply "$argument" ;;
                --report-posture | --report-posture=*) bool_pref PostureChecking "$argument" ;;
                --advertise-connector | --advertise-connector=*) bool_pref AppConnectorAdvertise "$argument" ;;
                --snat-subnet-routes | --snat-subnet-routes=*) set_pref NoSNAT "$(negate "$(bool_flag "$argument")")" ;;
                --stateful-filtering | --stateful-filtering=*) set_pref NoStatefulFiltering "$(negate "$(bool_flag "$argument")")" ;;
                --relay-server-port=*) set_pref RelayServerPort "${argument#--relay-server-port=}" ;;
                --accept-risk=*) : ;;
                --advertise-exit-node | --advertise-exit-node=* | --advertise-routes=*) : ;;
                --hostname=*)
                    set_pref Hostname "${argument#--hostname=}"
                    # The tailnet (status's Self) learns the name only while connected: set
                    # while not Running, status keeps the old one until `up` (observed)
                    is_running && set_pref StatusHostname "${argument#--hostname=}" ;;
                --nickname=*)
                    profiles_init
                    nickname=${argument#--nickname=}
                    awk -F '\t' -v OFS='\t' -v id="$(current_profile)" -v name="$nickname" '$1 == id { $2 = name } { print }' "$STATE_DIR/profiles" > "$STATE_DIR/profiles.new"
                    mv "$STATE_DIR/profiles.new" "$STATE_DIR/profiles" ;;
                --operator=*) set_pref OperatorUser "${argument#--operator=}" ;;
                --exit-node=*)
                    value=${argument#--exit-node=}
                    id=$(exit_node_id "$value")
                    if [ "$id" = "?" ]; then
                        printf 'invalid value "%s" for --exit-node: no node found in netmap with IP or name (stand-in)\n' "$value" >&2
                        exit 1
                    fi
                    set_pref ExitNodeID "$id"
                    case $scenario in
                        running | exit-node | exit-node-offline) [ -n "$id" ] && save_scenario exit-node || save_scenario running ;;
                    esac ;;
                *)
                    # Go's flag package names it with one dash
                    name=${argument%%=*}
                    printf 'flag provided but not defined: -%s\n' "${name#--}" >&2
                    exit 2 ;;
            esac
        done
        [ "$new_routes" != "$old_routes" ] && set_pref AdvertiseRoutes "$new_routes"
        true ;;
    up)
        need_daemon
        need_write "prefs write access denied" up "$@"
        if [ $# -gt 0 ]; then
            # Any flag defeats the bare-`up` path: the real CLI then demands every
            # non-default setting (the module must never get here)
            cat "$F/stderr-up-accidental-revert.txt" >&2
            exit 1
        fi
        case $scenario in
            needs-login | login-pending | key-expired | fresh | fresh-needs-login) login_flow ;;
            needs-machine-auth)
                printf '\nTo approve your machine, visit (as admin):\n\n\thttps://login.tailscale.com/admin/machines\n\n' >&2
                sleep "${TS_FAKE_LOGIN_DELAY:-2}" ;;
            stopped)
                set_pref WantRunning true
                delay=${TS_FAKE_UP_DELAY:-$(cat "$STATE_DIR/up-delay" 2> /dev/null || echo 0)}
                if [ "$delay" != 0 ]; then
                    # WantRunning is set at once; Running comes only after the wait (the real
                    # `up` returns only once the daemon is Running)
                    save_scenario starting
                    [ "${TS_FAKE_UP_URL:-0}" = 1 ] && printf '\nTo authenticate, visit:\n\n\thttps://login.tailscale.com/a/REDACTED\n\n' >&2
                    pause "$delay"
                    # Taken down meanwhile (`down` cleared WantRunning): never Running
                    if [ "$(get_pref WantRunning)" = false ]; then
                        echo "stand-in: the daemon was stopped while up waited" >&2
                        exit 1
                    fi
                fi
                # Connected: the tailnet learns a name set meanwhile
                set_pref StatusHostname "$(get_pref Hostname)"
                resume=$(cat "$STATE_DIR/resume" 2> /dev/null || echo running)
                save_scenario "$resume" ;;
            *) set_pref WantRunning true ;;
        esac ;;
    login)
        need_daemon
        need_write "prefs write access denied" login "$@"
        [ $# -gt 0 ] && { echo "stand-in: the module passes no flags to login" >&2; exit 2; }
        login_flow ;;
    logout)
        need_daemon
        need_write "logout access denied" logout "$@"
        set_pref LoggedOut true
        set_pref WantRunning false
        save_scenario needs-login ;;
    down)
        need_daemon
        need_write "prefs write access denied" down "$@"
        case $scenario in
            stopped | starting | needs-login | login-pending | key-expired | needs-machine-auth | fresh | fresh-needs-login) ;;
            *) printf '%s\n' "$scenario" > "$STATE_DIR/resume" ;;
        esac
        set_pref WantRunning false
        save_scenario stopped ;;
    ping)
        need_daemon
        target=""
        for argument in "$@"; do
            case $argument in -*) ;; *) target=$argument ;; esac
        done
        [ -n "$target" ] || { echo "usage: tailscale ping <hostname-or-IP>" >&2; exit 2; }
        if [ "${TS_FAKE_PING:-}" = timeout ]; then
            sed '$d' "$F/ping-timeout.txt"
            echo "no reply" >&2
            exit 1
        fi
        cat "$F/ping-direct.txt" ;;
    netcheck)
        need_daemon
        [ "${TS_FAKE_NETCHECK:-}" = fail ] && { echo "netcheck: UDP test failure: example (stand-in)" >&2; exit 1; }
        # As the real one: a log line on stderr, the JSON after a comment on stdout
        echo "2026/11/16 18:56:18 portmap: monitor: gateway and self IP changed (stand-in)" >&2
        cat "$F/netcheck-real.json" ;;
    file)
        need_daemon
        case ${1:-} in
            cp)
                shift
                [ "${1:-}" = --targets ] && { printf '100.64.0.4\tpeer4\n100.64.0.2\tpeer2\toffline; last seen 5m ago\n'; exit 0; }
                [ "${1:-}" = -- ] && shift
                last=""
                for argument in "$@"; do last=$argument; done
                case $last in
                    *:) [ $# -ge 2 ] || { echo "usage: tailscale file cp <files...> <target>:" >&2; exit 2; } ;;
                    *) echo "final argument to 'tailscale file cp' must end in colon" >&2; exit 1 ;;
                esac
                target=${last%:}
                # As cli/file.go: the target by its Tailscale address; the fixtures' peers are
                # 100.64.0.N with the stable id nPEER<N>CNTRL; TS_FAKE_SEND_REFUSE: one the
                # daemon will not send to (its TaildropTarget reason)
                case $target in
                    100.64.0.[0-9] | 100.64.0.[0-9][0-9]) peer=nPEER${target#100.64.0.}CNTRL ;;
                    *) echo "can't send to $target: unknown target; not in your Tailnet" >&2; exit 1 ;;
                esac
                [ -n "${TS_FAKE_SEND_REFUSE:-}" ] && { echo "can't send to $target: cannot send files: $TS_FAKE_SEND_REFUSE" >&2; exit 1; }
                is_running || { echo "can't send to $target: cannot send files: local Tailscale is not connected to the tailnet" >&2; exit 1; }
                count=$#
                index=0
                for file in "$@"; do
                    index=$((index + 1))
                    [ $index -lt $count ] || break
                    [ -e "$file" ] || { echo "open $file: no such file or directory" >&2; exit 1; }
                    [ -d "$file" ] && { echo "directories not supported" >&2; exit 1; }
                    [ -r "$file" ] || { echo "open $file: permission denied" >&2; exit 1; }
                done
                # The LocalAPI's file-put needs write access (root or the operator)
                need_write "file access denied" file cp "$@"
                # Each file: progress on the bus (OutgoingFiles, as feature/taildrop/localapi.go
                # sends it: started, ~1 s updates, finished), a copy in the state dir's sent/
                mkdir -p "$STATE_DIR/sent"
                index=0
                for file in "$@"; do
                    index=$((index + 1))
                    [ $index -lt $count ] || break
                    name=${file##*/}
                    size=$(wc -c < "$file" | tr -d ' ')
                    started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
                    id=f$index$$
                    outgoing() { # sent finished succeeded
                        [ -n "${TS_FAKE_BUS_FILE:-}" ] || return 0
                        printf '{"OutgoingFiles":[{"ID":"%s","PeerID":"%s","Name":"%s","Started":"%s","DeclaredSize":%s,"Sent":%s,"Finished":%s,"Succeeded":%s}]}\n' \
                            "$id" "$peer" "$(json_string "$name")" "$started" "$size" "$1" "$2" "$3" >> "$TS_FAKE_BUS_FILE"
                    }
                    outgoing 0 false false
                    if [ "${TS_FAKE_SEND_DELAY:-0}" != 0 ]; then
                        pause "$TS_FAKE_SEND_DELAY"
                        outgoing $((size / 2)) false false
                        pause "$TS_FAKE_SEND_DELAY"
                    fi
                    if [ "${TS_FAKE_SEND_FAIL:-}" = 1 ]; then
                        outgoing $((size / 2)) true false
                        echo "500 Internal Server Error: stand-in: the peer went away" >&2
                        exit 1
                    fi
                    cp -- "$file" "$STATE_DIR/sent/$name"
                    outgoing "$size" true true
                done ;;
            get)
                need_write "file access denied" file "$@" ;;
            *) echo "usage: tailscale file <cp|get> ..." >&2; exit 2 ;;
        esac ;;
    serve | funnel)
        need_daemon
        serve_command "$@" ;;
    lock)
        need_daemon
        if [ "${1:-}" = status ]; then
            shift
            json=false
            while [ $# -gt 0 ]; do
                case $1 in
                    --json | -json | --json=1 | -json=1) json=true ;;
                    --json=* | -json=*) printf 'unrecognised version: %s\n' "${1#*=}" >&2; exit 1 ;;
                    -*) name=${1#-}; printf 'flag provided but not defined: -%s\n' "${name#-}" >&2; exit 2 ;;
                    *) echo "tailscale lock status: unexpected argument" >&2; exit 1 ;;
                esac
                shift
            done
            if [ $json = true ]; then lock_json; else lock_text; fi
            exit 0
        fi
        echo "stand-in: lock ${1:-} not replayed" >&2; exit 2 ;;
    cert)
        need_daemon
        cert_command "$@" ;;
    *)
        echo "stand-in: '$command $*' not replayed" >&2
        exit 2 ;;
esac
