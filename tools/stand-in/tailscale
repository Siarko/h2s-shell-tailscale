#!/bin/sh
# h2s-stand-in: a stand-in `tailscale` CLI for the module's end-to-end tests: a small state machine over
# the redacted fixtures. It never touches a real tailscaled or the network. Put
# tools/stand-in first on PATH (or name it by absolute path where the module takes one).
#
# Environment:
#   TS_FAKE_FIXTURES     the fixtures directory (default: ../../fixtures from this script)
#   TS_FAKE_STATE_DIR    where the state lives between calls (default:
#                        ${XDG_RUNTIME_DIR:-/tmp}/ts-fake-$(id -u)); one directory per test
#   TS_FAKE_STATE        force a scenario for this call (else the state dir's, else running):
#                        running | stopped | starting | needs-login | needs-machine-auth |
#                        exit-node | exit-node-offline | key-expiring | key-expired |
#                        health-warnings | update-available | rich | not-running
#   TS_FAKE_DAEMON       "down": the daemon is not running (every daemon command fails);
#                        so is it while the state dir holds a file "daemon-down" (the stand-in
#                        systemctl removes it on `start tailscaled.service`)
#   TS_FAKE_OPERATOR     1: the caller may change (operator); 0 (default, as on the machine
#                        the fixtures come from): changes are denied with the real text.
#                        Also allowed: TS_FAKE_ROOT=1 (set by the stand-in pkexec), or a
#                        `set --operator=<user>` done earlier for TS_FAKE_USER (default $USER)
#   TS_FAKE_LOGIN_DELAY  seconds `login` / `up` wait after printing the auth URL (default 2)
#   TS_FAKE_LOGIN_RESULT "fail": the login ends with an error instead of success
#   TS_FAKE_BUS_DELAY    seconds between the objects `debug watch-ipn` prints (default 0)
#   TS_FAKE_PING         "timeout": ping gets no reply
#   TS_FAKE_NETCHECK     "fail": netcheck fails
#   TS_FAKE_LOGIN_URL_DELAY  seconds a `login` waits before it prints its URL (after the move
#                        to the empty profile)
#   TS_FAKE_LOGIN_DENY_AFTER_SWITCH  1: a `login` not as root moves to the empty profile, then
#                        is denied
#   TS_FAKE_LOGIN_SAME   1: a `login` from a logged-in profile logs in with the same account:
#                        merged into its profile with login's default prefs (the old ones
#                        lost, as the daemon does); else it adds account e5f6
#                        (user2@example.net). Each profile keeps its prefs (prefs.<id>)
#   TS_FAKE_UP_DELAY     seconds a bare `up` from Stopped waits before it reaches Running (a
#                        daemon that cannot get there: offline, a captive portal); default 0.
#                        Also a file "up-delay" in the state dir holding the seconds
#   TS_FAKE_UP_URL       1: that slow `up` first prints a login URL to stderr (as `up` does
#                        when the key expired), then waits
#   TS_FAKE_STATUS_HANG  seconds `status --json` hangs before it answers (a stuck daemon);
#                        also a file "status-hang" in the state dir holding the seconds
#   TS_FAKE_LOG          a file each call's arguments are appended to (one line per call)
#   TS_FAKE_SSH_CAP      0: the tailnet does not allow Tailscale SSH (`set --ssh` refused as the
#                        daemon does); also a file "no-ssh-cap" in the state dir
#   TS_FAKE_AUTO_UPDATE  ok: `set --auto-update` allowed (default: refused, as on NixOS)
#   TS_FAKE_SEND_DELAY   seconds between a `file cp` file's bus updates (0 none: started, then finished)
#   TS_FAKE_SEND_FAIL    1: the first file fails halfway (Finished, not Succeeded; exit 1)
#   TS_FAKE_SEND_REFUSE  a reason: `file cp` is refused with "cannot send files: <reason>"
#   Taildrop: `file cp -- <files…> <100.64.0.N>:` checks the files, needs write access (root or
#   the operator), appends OutgoingFiles lines to TS_FAKE_BUS_FILE and copies each file into
#   the state dir's sent/; the inbox (receiving) is the stand-in curl's files/
#   SSH_CLIENT           from a 100.x address: `set --ssh=<change>` asks for the lose-ssh risk
#                        and, with no terminal, aborts (as the real CLI)
#
# Sharing (step 3): `set --advertise-routes` / `--advertise-exit-node` compose as set.go's
# calcAdvertiseRoutesForSet (each alone keeps the other half of AdvertiseRoutes), routes are
# checked as netutil.CalcAdvertiseRoutes (host bits for IPv4 only), offering an exit node while
# using one (or the reverse) is refused with the daemon's text. An admin's approval is the
# state dir's file "approved" (one route per line): those advertised routes show in status's
# Self AllowedIPs (subnets also in PrimaryRoutes, the exit pair as ExitNodeOption). A
# `--hostname` set while not Running reaches status's Self only with the next `up`.
#
# State dir file "on-deny": a snippet run once when a write is denied ($1 the state dir).
# State dir files: scenario (the status fixture's name), prefs (key=value overrides of the
# prefs fixture), resume (the scenario `up` returns to), profiles and current (the accounts:
# see profiles_init), login-from (the account a pending `login` started from).
set -eu

here=$(cd "$(dirname "$0")" && pwd)
F=${TS_FAKE_FIXTURES:-$here/../../fixtures}
STATE_DIR=${TS_FAKE_STATE_DIR:-${XDG_RUNTIME_DIR:-/tmp}/ts-fake-$(id -u)}
mkdir -p "$STATE_DIR"
[ -n "${TS_FAKE_LOG:-}" ] && printf '%s\n' "$*" >> "$TS_FAKE_LOG"

scenario=${TS_FAKE_STATE:-}
[ -z "$scenario" ] && [ -f "$STATE_DIR/scenario" ] && scenario=$(cat "$STATE_DIR/scenario")
[ -z "$scenario" ] && scenario=running
[ "${TS_FAKE_DAEMON:-}" = down ] && scenario=not-running
# The daemon stopped by a test (a file, so that a stand-in systemctl can start it again)
[ -f "$STATE_DIR/daemon-down" ] && scenario=not-running

save_scenario() { printf '%s\n' "$1" > "$STATE_DIR/scenario"; scenario=$1; }

# key=value overrides of the prefs, the last one of a key wins
set_pref() { printf '%s=%s\n' "$1" "$2" >> "$STATE_DIR/prefs"; }
get_pref() { [ -f "$STATE_DIR/prefs" ] && sed -n "s/^$1=//p" "$STATE_DIR/prefs" | tail -n 1; return 0; }

need_daemon() {
    if [ "$scenario" = not-running ]; then
        cat "$F/stderr-not-running.txt" >&2
        exit 1
    fi
}

can_write() {
    [ "${TS_FAKE_ROOT:-0}" = 1 ] && return 0
    [ "${TS_FAKE_OPERATOR:-0}" = 1 ] && return 0
    operator=$(get_pref OperatorUser)
    [ -n "$operator" ] && [ "$operator" = "${TS_FAKE_USER:-${USER:-}}" ] && return 0
    return 1
}

# The real denial: LocalAPI's 403 text, then the CLI's advice with the command as typed
denied() {
    what=$1
    shift
    # A change made elsewhere at that moment (a test's "meanwhile"): the state dir's file
    # "on-deny", a shell snippet run once with $1 = the state dir, then removed
    if [ -f "$STATE_DIR/on-deny" ]; then
        hook=$(cat "$STATE_DIR/on-deny")
        rm -f "$STATE_DIR/on-deny"
        sh -c "$hook" sh "$STATE_DIR"
    fi
    printf "Access denied: %s\n\nUse 'sudo tailscale %s'.\nTo not require root, use 'sudo tailscale set --operator=\$USER' once.\n" "$what" "$*" >&2
    exit 1
}
need_write() { # $1 the denial text, then the command as typed
    what=$1
    shift
    can_write || denied "$what" "$@"
}

# Waits $1 seconds, ended with its sleep by TERM (as the module's timeout or the module ends it)
pause() {
    sleep "$1" &
    sleeper=$!
    trap 'kill "$sleeper" 2> /dev/null; exit 143' TERM INT HUP
    wait "$sleeper"
    trap - TERM INT HUP
}

status_fixture() {
    case $scenario in
        login-pending) echo "$F/status-needs-login.json"; return ;;
    esac
    # The account in use may have a fixture of its own (status-running-work.json)
    suffix=$(profile_field "$(current_profile)" 5)
    if [ -n "$suffix" ] && [ -f "$F/status-$scenario-$suffix.json" ]; then
        echo "$F/status-$scenario-$suffix.json"
    else
        echo "$F/status-$scenario.json"
    fi
}

# The status fixture, with the name the tailnet knows (a --hostname set while connected, or
# applied by the next `up`: StatusHostname) as this computer's (Self's HostName and the first
# label of its DNSName: the first of each in the fixtures), and the advertised routes an admin
# approved (the file "approved" in the state dir, one route per line) in Self's AllowedIPs —
# subnet routes in PrimaryRoutes too, the exit-node pair as ExitNodeOption (as ipnlocal's
# peerStatusFromNode fills them)
print_status() {
    hostname=$(get_pref StatusHostname)
    approved=""
    if [ -f "$STATE_DIR/approved" ]; then
        advertised=$(current_routes)
        while IFS= read -r route; do
            [ -n "$route" ] && has_route "$advertised" "$route" && approved="${approved:+$approved,}$route"
        done < "$STATE_DIR/approved"
    fi
    if [ -n "$hostname" ]; then
        sed "0,/\"HostName\": \"[^\"]*\"/s//\"HostName\": \"$hostname\"/; 0,/\"DNSName\": \"[^.\"]*\./s//\"DNSName\": \"$hostname./" "$(status_fixture)"
    else
        cat "$(status_fixture)"
    fi | awk -v approved="$approved" '
        BEGIN { n = split(approved, list, ","); exit4 = 0; exit6 = 0; subnets = ""
                for (i = 1; i <= n; i++) { if (list[i] == "0.0.0.0/0") exit4 = 1; else if (list[i] == "::/0") exit6 = 1
                                            else subnets = subnets (subnets == "" ? "" : ",") list[i] } }
        # Self is the first object with four-space keys; its AllowedIPs is the first such array
        !self_done && /^    "AllowedIPs": \[/ { in_allowed = 1; print; next }
        in_allowed && /^    \]/ {
            for (i = 1; i <= n; i++) print "      ,\"" list[i] "\""
            print
            if (subnets != "") { m = split(subnets, sub_list, ","); print "    \"PrimaryRoutes\": ["
                for (i = 1; i <= m; i++) print "      " (i > 1 ? "," : "") "\"" sub_list[i] "\""; print "    ]," }
            in_allowed = 0; self_done = 1; next }
        !exit_done && /^    "ExitNodeOption": / { exit_done = 1; if (exit4 && exit6) { print "    \"ExitNodeOption\": true,"; next } }
        { print }'
}

prefs_base() {
    case $scenario in
        stopped) echo "$F/prefs-stopped.json" ;;
        needs-login | login-pending) echo "$F/prefs-logged-out.json" ;;
        # An expired key is not a logout: the prefs stay those of a logged-in machine
        key-expired) echo "$F/prefs-running.json" ;;
        exit-node | exit-node-offline) echo "$F/prefs-exit-node.json" ;;
        rich) echo "$F/prefs-rich.json" ;;
        sharing) echo "$F/prefs-sharing.json" ;;
        *) echo "$F/prefs-running.json" ;;
    esac
}


# Accounts (profiles): "profiles" in the state dir, one per line — id, nickname, tailnet,
# account, the status fixture's suffix ("" the plain one; "work": status-running-work.json) —
# tab-separated; "current" the id in use ("" a new, empty profile: `login` while logged in
# starts one). Two accounts to begin with, as switch-list.json.
profiles_init() {
    [ -f "$STATE_DIR/profiles" ] && return 0
    printf 'a1b2\t\texample-tailnet.ts.net\tuser1@example.com\t\nc3d4\twork\texample.org\tuser1@example.org\twork\n' > "$STATE_DIR/profiles"
    [ -f "$STATE_DIR/current" ] || printf 'a1b2\n' > "$STATE_DIR/current"
}
current_profile() { profiles_init; cat "$STATE_DIR/current" 2> /dev/null || true; }
profile_field() { # profile_field <id> <column 1-5>
    awk -F '\t' -v id="$1" -v column="$2" '$1 == id { print $column; exit }' "$STATE_DIR/profiles"
}
profile_exists() { profiles_init; [ -n "$1" ] && awk -F '\t' -v id="$1" '$1 == id { found = 1 } END { exit !found }' "$STATE_DIR/profiles"; }
print_profiles() { # --json or the table
    profiles_init
    current=$(current_profile)
    if [ "${1:-}" = json ]; then
        awk -F '\t' -v current="$current" 'BEGIN { printf "[" } { printf "%s\n  {\n    \"id\": \"%s\",\n    \"nickname\": \"%s\",\n    \"tailnet\": \"%s\",\n    \"account\": \"%s\",\n    \"selected\": %s\n  }", (NR > 1 ? "," : ""), $1, $2, $3, $4, ($1 == current ? "true" : "false") } END { print "\n]" }' "$STATE_DIR/profiles"
    else
        printf 'ID    Tailnet                 Account\n'
        awk -F '\t' -v current="$current" '{ printf "%-5s %-23s %s%s\n", $1, $3, $4, ($1 == current ? "*" : "") }' "$STATE_DIR/profiles"
    fi
}

json_string() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# The prefs fixture with the overrides applied (one "Key": value per line in the fixtures)
print_prefs() {
    base=$(prefs_base)
    script=""
    for key in RouteAll CorpDNS ShieldsUp ExitNodeAllowLANAccess RunSSH RunWebClient WantRunning LoggedOut NoSNAT NoStatefulFiltering PostureChecking; do
        value=$(get_pref "$key")
        [ -n "$value" ] && script="$script s/^\\(  \"$key\": \\)[a-z]*/\\1$value/;"
    done
    # Nested ones: AppConnector.Advertise, AutoUpdate.Check / .Apply (four spaces in)
    value=$(get_pref AppConnectorAdvertise)
    [ -n "$value" ] && script="$script s/^\\(    \"Advertise\": \\)[a-z]*/\\1$value/;"
    value=$(get_pref UpdateCheck)
    [ -n "$value" ] && script="$script s/^\\(    \"Check\": \\)[a-z]*/\\1$value/;"
    value=$(get_pref AutoUpdateApply)
    [ -n "$value" ] && script="$script s/^\\(    \"Apply\": \\)[a-z]*/\\1$value/;"
    # RelayServerPort: omitted while off (Go's omitempty), a number when on
    value=$(get_pref RelayServerPort)
    [ -n "$value" ] && script="$script s/^\\(  \"Hostname\": .*\\)$/\\1\\n  \"RelayServerPort\": $value,/;"
    value=$(get_pref ExitNodeID)
    [ -f "$STATE_DIR/prefs" ] && grep -q '^ExitNodeID=' "$STATE_DIR/prefs" \
        && script="$script s/^\\(  \"ExitNodeID\": \\)\"[^\"]*\"/\\1\"$value\"/;"
    if grep -q '^Hostname=' "$STATE_DIR/prefs" 2> /dev/null; then
        value=$(json_string "$(get_pref Hostname)")
        script="$script s/^\\(  \"Hostname\": \\)\"[^\"]*\"/\\1\"$value\"/;"
    fi
    operator=$(get_pref OperatorUser)
    if [ -n "$operator" ]; then
        # The fixtures have no OperatorUser line (Go omits it while empty): add one
        grep -q '"OperatorUser"' "$base" \
            && script="$script s/^\\(  \"OperatorUser\": \\)\"[^\"]*\"/\\1\"$operator\"/;" \
            || script="$script s/^\\(  \"Hostname\": .*\\)$/\\1\\n  \"OperatorUser\": \"$operator\",/;"
    fi
    # The account in use names the prefs' login (an empty profile: none)
    if [ -f "$STATE_DIR/current" ]; then
        account=$(profile_field "$(current_profile)" 4)
        # The account's nickname is the prefs' ProfileName (`set --nickname`)
        nickname=$(profile_field "$(current_profile)" 2)
        [ -n "$nickname" ] && script="$script s/^\\(  \"Hostname\": .*\\)$/\\1\\n  \"ProfileName\": \"$nickname\",/;"
        script="$script s/^\\(      \"LoginName\": \\)\"[^\"]*\"/\\1\"$account\"/;"
    fi
    # AdvertiseRoutes from its override (null when empty), else as the fixture has it
    if grep -q '^AdvertiseRoutes=' "$STATE_DIR/prefs" 2> /dev/null; then
        sed "$script" "$base" | awk -v routes="$(get_pref AdvertiseRoutes)" '
            /^  "AdvertiseRoutes": / {
                if (routes == "") print "  \"AdvertiseRoutes\": null,"
                else { n = split(routes, list, ","); print "  \"AdvertiseRoutes\": ["
                       for (i = 1; i <= n; i++) print "    \"" list[i] "\"" (i < n ? "," : ""); print "  ]," }
                if ($0 ~ /\[$/) skip = 1
                next }
            skip { if ($0 ~ /^  \]/) skip = 0; next }
            { print }'
    else
        sed "$script" "$base"
    fi
}

bool_flag() { # --name or --name=true|false → true|false; anything else: Go's flag error
    case $1 in
        *=true | *=1) echo true ;;
        *=false | *=0) echo false ;;
        *=*) echo "invalid boolean value \"${1#*=}\" for ${1%%=*}: parse error" >&2; exit 2 ;;
        *) echo true ;;
    esac
}

bool_pref() { value=$(bool_flag "$2") || exit 2; set_pref "$1" "$value"; }

exit_node_id() { # the argument of --exit-node → a node id, or "" when no node matches
    case $1 in
        "") echo "" ;;
        peer4 | 100.64.0.4 | peer4.example-tailnet.ts.net | peer4.example-tailnet.ts.net.) echo nPEER4CNTRL ;;
        peer10 | 100.64.0.10 | peer10.example-tailnet.ts.net | peer10.example-tailnet.ts.net.) echo nPEER10CNTRL ;;
        auto:any) echo nPEER4CNTRL ;;
        *) echo "?" ;;
    esac
}

# The current profile's prefs overrides kept under its id (an empty profile: none kept)
save_profile_prefs() {
    [ -n "$1" ] || return 0
    if [ -f "$STATE_DIR/prefs" ]; then cp "$STATE_DIR/prefs" "$STATE_DIR/prefs.$1"; else : > "$STATE_DIR/prefs.$1"; fi
}
# login's defaults, over whatever fixture the scenario reads (accept routes off, no exit node,
# no hostname, no operator)
default_prefs() {
    printf 'RouteAll=false\nCorpDNS=true\nShieldsUp=false\nExitNodeAllowLANAccess=false\nRunSSH=false\nExitNodeID=\nHostname=\nWantRunning=false\nStatusHostname=\nAdvertiseRoutes=\nRunWebClient=false\n' > "$STATE_DIR/prefs"
}

login_flow() {
    profiles_init
    case $scenario in
        needs-login | login-pending | key-expired) ;;
        *)
            # Logged in: `login` first moves to a new, empty profile (cli/login.go:
            # SwitchToEmptyProfile) — before any URL: the connection drops at once. The one
            # before keeps its prefs (saved per profile); the empty one has login's defaults
            from=$(current_profile)
            printf '%s\n' "$from" > "$STATE_DIR/login-from"
            save_profile_prefs "$from"
            default_prefs
            : > "$STATE_DIR/current" ;;
    esac
    save_scenario login-pending
    # A login refused after that move (TS_FAKE_LOGIN_DENY_AFTER_SWITCH=1, not as root): the
    # daemon stays on the empty profile
    if [ "${TS_FAKE_LOGIN_DENY_AFTER_SWITCH:-0}" = 1 ] && [ "${TS_FAKE_ROOT:-0}" != 1 ]; then
        denied "prefs write access denied" login
    fi
    # The URL may come late (TS_FAKE_LOGIN_URL_DELAY seconds): the move happened already
    [ "${TS_FAKE_LOGIN_URL_DELAY:-0}" != 0 ] && pause "$TS_FAKE_LOGIN_URL_DELAY"
    printf '\nTo authenticate, visit:\n\n\thttps://login.tailscale.com/a/REDACTED\n\n' >&2
    # Killable while it waits (the module ends a login that takes too long): the sleep goes too
    sleep "${TS_FAKE_LOGIN_DELAY:-2}" &
    sleeper=$!
    trap 'kill "$sleeper" 2> /dev/null; exit 143' TERM INT HUP
    wait "$sleeper"
    trap - TERM INT HUP
    if [ "${TS_FAKE_LOGIN_RESULT:-}" = fail ]; then
        save_scenario needs-login
        echo "backend error: example login failure" >&2
        exit 1
    fi
    from=$(cat "$STATE_DIR/login-from" 2> /dev/null || true)
    rm -f "$STATE_DIR/login-from"
    if [ -z "$(current_profile)" ]; then
        if [ -n "$from" ] && [ "${TS_FAKE_LOGIN_SAME:-0}" = 1 ]; then
            # The same account again: the daemon merges the new profile into its old one
            # — with the new profile's prefs, login's defaults (ipnlocal/profiles.go): the old
            # exit node, routes, hostname, nickname and operator are gone
            printf '%s\n' "$from" > "$STATE_DIR/current"
            rm -f "$STATE_DIR/prefs.$from"
            awk -F '\t' -v OFS='\t' -v id="$from" '$1 == id { $2 = "" } { print }' "$STATE_DIR/profiles" > "$STATE_DIR/profiles.new"
            mv "$STATE_DIR/profiles.new" "$STATE_DIR/profiles"
        else
            # Another account (TS_FAKE_LOGIN_SAME=1: the same one)
            grep -q '^e5f6	' "$STATE_DIR/profiles" || printf 'e5f6\t\texample.net\tuser2@example.net\t\n' >> "$STATE_DIR/profiles"
            printf 'e5f6\n' > "$STATE_DIR/current"
        fi
    fi
    set_pref LoggedOut false
    set_pref WantRunning true
    save_scenario running
    printf 'Success.\n' >&2
}

negate() { [ "$1" = true ] && echo false || echo true; }

# The status fixture says Running (the tailnet hears about prefs changes only then)
is_running() { grep -q '"BackendState": "Running"' "$(status_fixture)"; }

# A key's value in the printed prefs (one "Key": value line, two spaces in)
prefs_value() { print_prefs | sed -n "s/^  \"$1\": \"\{0,1\}\([^\"]*\)\"\{0,1\},\{0,1\}\$/\1/p" | head -n 1; }

# AdvertiseRoutes as a comma list: the override, else the fixture's array
current_routes() {
    if grep -q '^AdvertiseRoutes=' "$STATE_DIR/prefs" 2> /dev/null; then
        get_pref AdvertiseRoutes
    else
        awk '/^  "AdvertiseRoutes": \[/ { on = 1; next } on && /^  \]/ { exit } on { gsub(/[ ",]/, ""); if ($0 != "") list = list (list == "" ? "" : ",") $0 } END { print list }' "$(prefs_base)"
    fi
}
has_route() { case ",$1," in *",$2,"*) return 0 ;; esac; return 1; }
advertises_exit() { has_route "$1" 0.0.0.0/0 && has_route "$1" ::/0; }

# net/netutil/routes.go CalcAdvertiseRoutes: each prefix parsed (an address alone is not one),
# no host bits (checked for IPv4 here), a /0 only with its other-family twin; the exit pair
# added when asked; deduplicated, sorted by prefix length. Prints the list or fails as the CLI
calc_routes() { # calc_routes <comma list> <true|false: add the exit pair>
    list=""
    default4=false
    default6=false
    old_ifs=$IFS
    IFS=,
    for route in $1; do
        IFS=$old_ifs
        case $route in
            *.*.*.*/*)
                masked=$(printf '%s\n' "$route" | awk -F '[./]' 'NF == 5 && $5 ~ /^(0|[1-9][0-9]?)$/ && $5 + 0 <= 32 {
                    for (i = 1; i <= 4; i++) if ($i !~ /^(0|[1-9][0-9]?[0-9]?)$/ || $i + 0 > 255) exit
                    out = ""
                    for (i = 1; i <= 4; i++) { keep = $5 - (i - 1) * 8; keep = keep < 0 ? 0 : (keep > 8 ? 8 : keep)
                        step = 2 ^ (8 - keep); out = out (i > 1 ? "." : "") int($i / step) * step }
                    print out "/" $5 }')
                [ -n "$masked" ] || { printf '"%s" is not a valid IP address or CIDR prefix\n' "$route" >&2; exit 1; }
                [ "$masked" = "$route" ] || { printf '%s has non-address bits set; expected %s\n' "$route" "$masked" >&2; exit 1; } ;;
            *:*/*)
                printf '%s\n' "$route" | grep -Eq '^[0-9a-fA-F:]+/(0|[1-9][0-9]?|1[01][0-9]|12[0-8])$' \
                    || { printf '"%s" is not a valid IP address or CIDR prefix\n' "$route" >&2; exit 1; } ;;
            *) printf '"%s" is not a valid IP address or CIDR prefix\n' "$route" >&2; exit 1 ;;
        esac
        [ "$route" = 0.0.0.0/0 ] && default4=true
        [ "$route" = ::/0 ] && default6=true
        has_route "$list" "$route" || list="${list:+$list,}$route"
        IFS=,
    done
    IFS=$old_ifs
    [ $default4 = true ] && [ $default6 = false ] && { echo "0.0.0.0/0 advertised without its IPv6 counterpart, please also advertise ::/0" >&2; exit 1; }
    [ $default6 = true ] && [ $default4 = false ] && { echo "::/0 advertised without its IPv4 counterpart, please also advertise 0.0.0.0/0" >&2; exit 1; }
    if [ "$2" = true ]; then
        has_route "$list" 0.0.0.0/0 || list="${list:+$list,}0.0.0.0/0"
        has_route "$list" ::/0 || list="${list:+$list,}::/0"
    fi
    printf '%s\n' "$list" | tr , '\n' | awk -F / 'NF { print $2 "\t" $0 }' | sort -n -s -k1,1 | cut -f2 | paste -sd , -
}

# The checks of a `set` before anything is written (set.go, then the daemon's checkPrefs):
# leaves new_routes / old_routes for the writes
set_checks() {
    routes_given=false
    exit_given=false
    exit_value=false
    exit_node_after=$(prefs_value ExitNodeID)
    ssh_after=""
    risk=""
    for argument in "$@"; do
        case $argument in
            --advertise-routes=*) routes_given=true; routes_value=${argument#--advertise-routes=} ;;
            --advertise-exit-node | --advertise-exit-node=*) exit_given=true; exit_value=$(bool_flag "$argument") || exit 2 ;;
            --exit-node=*) exit_node_after=$(exit_node_id "${argument#--exit-node=}") ;;
            --ssh | --ssh=*) ssh_after=$(bool_flag "$argument") || exit 2 ;;
            --accept-risk=*) risk=${argument#--accept-risk=} ;;
            --relay-server-port=*)
                port=${argument#--relay-server-port=}
                if [ -n "$port" ]; then
                    printf '%s\n' "$port" | grep -Eq '^[0-9]{1,5}$' && [ "$port" -le 65535 ] \
                        || { printf 'failed to set relay server port: strconv.ParseUint: parsing "%s": invalid syntax\n' "$port" >&2; exit 1; }
                fi ;;
            --auto-update | --auto-update=*)
                # NixOS: the daemon cannot update itself (ipnlocal checkAutoUpdatePrefsLocked)
                if [ "$(bool_flag "$argument")" = true ] && [ "${TS_FAKE_AUTO_UPDATE:-}" != ok ]; then
                    echo "Auto-updates are not supported on this platform." >&2
                    exit 1
                fi ;;
            --accept-routes* | --accept-dns* | --shields-up* | --exit-node-allow-lan-access* | --webclient* | --update-check* \
                | --report-posture* | --advertise-connector* | --snat-subnet-routes* | --stateful-filtering* | --hostname=* \
                | --nickname=* | --operator=*) ;;
            *)
                name=${argument%%=*}
                printf 'flag provided but not defined: -%s\n' "${name#--}" >&2
                exit 2 ;;
        esac
    done
    old_routes=$(current_routes)
    new_routes=$old_routes
    if [ $routes_given = true ] && [ $exit_given = true ]; then
        new_routes=$(calc_routes "$routes_value" "$exit_value") || exit 1
    elif [ $routes_given = true ]; then
        advertises_exit "$old_routes" && was=true || was=false
        new_routes=$(calc_routes "$routes_value" "$was") || exit 1
    elif [ $exit_given = true ]; then
        advertises_exit "$old_routes" && was=true || was=false
        if [ "$was" != "$exit_value" ]; then
            kept=$(printf '%s\n' "$old_routes" | tr , '\n' | grep -v '/0$' | paste -sd , -)
            new_routes=$(calc_routes "$kept" "$exit_value") || exit 1
        fi
    fi
    # The daemon's checkExitNodePrefsLocked
    if [ -n "$exit_node_after" ] && [ "$exit_node_after" != "?" ] && advertises_exit "$new_routes"; then
        echo "Cannot advertise an exit node and use an exit node at the same time." >&2
        exit 1
    fi
    if [ -n "$ssh_after" ]; then
        # checkSSHPrefsLocked: the tailnet must allow it (TS_FAKE_SSH_CAP=0 or a file
        # "no-ssh-cap": it does not)
        if [ "$ssh_after" = true ] && { [ "${TS_FAKE_SSH_CAP:-1}" = 0 ] || [ -f "$STATE_DIR/no-ssh-cap" ]; }; then
            echo "Unable to enable local Tailscale SSH server; not enabled on Tailnet. See https://tailscale.com/s/ssh" >&2
            exit 1
        fi
        # cli/up.go presentSSHToggleRisk: only inside an SSH session over Tailscale (SSH_CLIENT
        # from a 100.x address); with no terminal the prompt answers no
        case ${SSH_CLIENT:-} in
            100.*)
                if [ "$ssh_after" != "$(prefs_value RunSSH)" ] && [ "$risk" != lose-ssh ] && [ "$risk" != all ]; then
                    echo "You are connected over Tailscale; this action will reroute SSH traffic to Tailscale SSH and will result in your session disconnecting."
                    echo "To skip this warning, use --accept-risk=lose-ssh"
                    echo "aborted, no changes made" >&2
                    exit 1
                fi ;;
        esac
    fi
}

command=${1:-}
[ $# -gt 0 ] && shift
case $command in
    version)
        case " $* " in
            *" --json "*) cat "$F/version.json" ;;
            *) printf '1.104.4\n  tailscale commit: 0000000000000000000000000000000000000000\n  long version: 1.104.4-stand-in\n' ;;
        esac ;;
    dns)
        need_daemon
        case " $* " in
            *status*--json* | *--json*status*) cat "$F/dns-status.json" ;;
            *) echo "stand-in: only dns status --json is replayed" >&2; exit 2 ;;
        esac ;;
    status)
        need_daemon
        hang=${TS_FAKE_STATUS_HANG:-$(cat "$STATE_DIR/status-hang" 2> /dev/null || echo 0)}
        [ "$hang" != 0 ] && pause "$hang"
        case " $* " in
            *" --json "* | *" --json=true "*) print_status ;;
            *) echo "# stand-in: only status --json is replayed" ;;
        esac ;;
    ip)
        need_daemon
        printf '100.64.0.1\nfd7a:115c:a1e0::1\n' ;;
    debug)
        need_daemon
        case ${1:-} in
            prefs) print_prefs ;;
            derp-map) cat "$F/derp-map.json" ;;
            watch-ipn)
                while IFS= read -r line; do
                    printf '%s\n' "$line"
                    [ "$line" = "}" ] && [ "${TS_FAKE_BUS_DELAY:-0}" != 0 ] && sleep "$TS_FAKE_BUS_DELAY"
                done < "$F/bus-pretty.txt"
                ;;
            *) echo "stand-in: debug ${1:-} not replayed" >&2; exit 2 ;;
        esac ;;
    exit-node)
        need_daemon
        case ${1:-} in
            list) cat "$F/exit-node-list.txt" ;;
            suggest) cat "$F/exit-node-suggest.txt" ;;
            *) echo "stand-in: exit-node ${1:-} not replayed" >&2; exit 2 ;;
        esac ;;
    switch)
        need_daemon
        need_write "profiles access denied" switch "$@"
        case ${1:-} in
            --list)
                case " $* " in
                    *" --json "*) print_profiles json ;;
                    *) print_profiles ;;
                esac ;;
            remove)
                profile_exists "${2:-}" || { printf 'No profile named "%s"\n' "${2:-}" >&2; exit 1; }
                awk -F '\t' -v id="$2" '$1 != id' "$STATE_DIR/profiles" > "$STATE_DIR/profiles.new"
                mv "$STATE_DIR/profiles.new" "$STATE_DIR/profiles"
                # The one in use removed: an empty profile (the module never asks for that)
                if [ "$(current_profile)" = "$2" ]; then : > "$STATE_DIR/current"; save_scenario needs-login; fi
                ;;
            *)
                profile_exists "${1:-}" || { printf 'No profile named "%s"\n' "${1:-}" >&2; exit 1; }
                if [ "$(current_profile)" = "$1" ]; then
                    printf 'Already on account "%s"\n' "$(profile_field "$1" 4)"
                else
                    # Each profile has its prefs: the old one's kept, the new one's restored
                    save_profile_prefs "$(current_profile)"
                    if [ -f "$STATE_DIR/prefs.$1" ]; then mv "$STATE_DIR/prefs.$1" "$STATE_DIR/prefs"; else : > "$STATE_DIR/prefs"; fi
                    printf '%s\n' "$1" > "$STATE_DIR/current"
                    printf 'Switching to account "%s"\n' "$(profile_field "$1" 4)"
                    # Every account of the stand-in is a logged-in, running one
                    case $scenario in needs-login | login-pending) save_scenario running ;; esac
                fi ;;
        esac ;;
    set)
        need_daemon
        need_write "prefs write access denied" set "$@"
        [ $# -gt 0 ] || { echo "usage: tailscale set [flags]" >&2; exit 2; }
        # All or nothing, as the real `set` (one EditPrefs): the checks first, then the writes
        set_checks "$@"
        for argument in "$@"; do
            case $argument in
                --accept-routes | --accept-routes=*) bool_pref RouteAll "$argument" ;;
                --accept-dns | --accept-dns=*) bool_pref CorpDNS "$argument" ;;
                --shields-up | --shields-up=*) bool_pref ShieldsUp "$argument" ;;
                --exit-node-allow-lan-access | --exit-node-allow-lan-access=*) bool_pref ExitNodeAllowLANAccess "$argument" ;;
                --ssh | --ssh=*) bool_pref RunSSH "$argument" ;;
                --webclient | --webclient=*) bool_pref RunWebClient "$argument" ;;
                --update-check | --update-check=*) bool_pref UpdateCheck "$argument" ;;
                --auto-update | --auto-update=*) bool_pref AutoUpdateApply "$argument" ;;
                --report-posture | --report-posture=*) bool_pref PostureChecking "$argument" ;;
                --advertise-connector | --advertise-connector=*) bool_pref AppConnectorAdvertise "$argument" ;;
                --snat-subnet-routes | --snat-subnet-routes=*) set_pref NoSNAT "$(negate "$(bool_flag "$argument")")" ;;
                --stateful-filtering | --stateful-filtering=*) set_pref NoStatefulFiltering "$(negate "$(bool_flag "$argument")")" ;;
                --relay-server-port=*) set_pref RelayServerPort "${argument#--relay-server-port=}" ;;
                --accept-risk=*) : ;;
                --advertise-exit-node | --advertise-exit-node=* | --advertise-routes=*) : ;;
                --hostname=*)
                    set_pref Hostname "${argument#--hostname=}"
                    # The tailnet (status's Self) learns the name only while connected: set
                    # while not Running, status keeps the old one until `up` (observed)
                    is_running && set_pref StatusHostname "${argument#--hostname=}" ;;
                --nickname=*)
                    profiles_init
                    nickname=${argument#--nickname=}
                    awk -F '\t' -v OFS='\t' -v id="$(current_profile)" -v name="$nickname" '$1 == id { $2 = name } { print }' "$STATE_DIR/profiles" > "$STATE_DIR/profiles.new"
                    mv "$STATE_DIR/profiles.new" "$STATE_DIR/profiles" ;;
                --operator=*) set_pref OperatorUser "${argument#--operator=}" ;;
                --exit-node=*)
                    value=${argument#--exit-node=}
                    id=$(exit_node_id "$value")
                    if [ "$id" = "?" ]; then
                        printf 'invalid value "%s" for --exit-node: no node found in netmap with IP or name (stand-in)\n' "$value" >&2
                        exit 1
                    fi
                    set_pref ExitNodeID "$id"
                    case $scenario in
                        running | exit-node | exit-node-offline) [ -n "$id" ] && save_scenario exit-node || save_scenario running ;;
                    esac ;;
                *)
                    # Go's flag package names it with one dash
                    name=${argument%%=*}
                    printf 'flag provided but not defined: -%s\n' "${name#--}" >&2
                    exit 2 ;;
            esac
        done
        [ "$new_routes" != "$old_routes" ] && set_pref AdvertiseRoutes "$new_routes"
        true ;;
    up)
        need_daemon
        need_write "prefs write access denied" up "$@"
        if [ $# -gt 0 ]; then
            # Any flag defeats the bare-`up` path: the real CLI then demands every
            # non-default setting (the module must never get here)
            cat "$F/stderr-up-accidental-revert.txt" >&2
            exit 1
        fi
        case $scenario in
            needs-login | login-pending | key-expired) login_flow ;;
            needs-machine-auth)
                printf '\nTo approve your machine, visit (as admin):\n\n\thttps://login.tailscale.com/admin/machines\n\n' >&2
                sleep "${TS_FAKE_LOGIN_DELAY:-2}" ;;
            stopped)
                set_pref WantRunning true
                delay=${TS_FAKE_UP_DELAY:-$(cat "$STATE_DIR/up-delay" 2> /dev/null || echo 0)}
                if [ "$delay" != 0 ]; then
                    # WantRunning is set at once; Running comes only after the wait (the real
                    # `up` returns only once the daemon is Running)
                    save_scenario starting
                    [ "${TS_FAKE_UP_URL:-0}" = 1 ] && printf '\nTo authenticate, visit:\n\n\thttps://login.tailscale.com/a/REDACTED\n\n' >&2
                    pause "$delay"
                    # Taken down meanwhile (`down` cleared WantRunning): never Running
                    if [ "$(get_pref WantRunning)" = false ]; then
                        echo "stand-in: the daemon was stopped while up waited" >&2
                        exit 1
                    fi
                fi
                # Connected: the tailnet learns a name set meanwhile
                set_pref StatusHostname "$(get_pref Hostname)"
                resume=$(cat "$STATE_DIR/resume" 2> /dev/null || echo running)
                save_scenario "$resume" ;;
            *) set_pref WantRunning true ;;
        esac ;;
    login)
        need_daemon
        need_write "prefs write access denied" login "$@"
        [ $# -gt 0 ] && { echo "stand-in: the module passes no flags to login" >&2; exit 2; }
        login_flow ;;
    logout)
        need_daemon
        need_write "logout access denied" logout "$@"
        set_pref LoggedOut true
        set_pref WantRunning false
        save_scenario needs-login ;;
    down)
        need_daemon
        need_write "prefs write access denied" down "$@"
        case $scenario in
            stopped | starting | needs-login | login-pending | key-expired | needs-machine-auth) ;;
            *) printf '%s\n' "$scenario" > "$STATE_DIR/resume" ;;
        esac
        set_pref WantRunning false
        save_scenario stopped ;;
    ping)
        need_daemon
        target=""
        for argument in "$@"; do
            case $argument in -*) ;; *) target=$argument ;; esac
        done
        [ -n "$target" ] || { echo "usage: tailscale ping <hostname-or-IP>" >&2; exit 2; }
        if [ "${TS_FAKE_PING:-}" = timeout ]; then
            sed '$d' "$F/ping-timeout.txt"
            echo "no reply" >&2
            exit 1
        fi
        cat "$F/ping-direct.txt" ;;
    netcheck)
        need_daemon
        [ "${TS_FAKE_NETCHECK:-}" = fail ] && { echo "netcheck: UDP test failure: example (stand-in)" >&2; exit 1; }
        # As the real one: a log line on stderr, the JSON after a comment on stdout
        echo "2026/11/16 18:56:18 portmap: monitor: gateway and self IP changed (stand-in)" >&2
        cat "$F/netcheck-real.json" ;;
    file)
        need_daemon
        case ${1:-} in
            cp)
                shift
                [ "${1:-}" = --targets ] && { printf '100.64.0.4\tpeer4\n100.64.0.2\tpeer2\toffline; last seen 5m ago\n'; exit 0; }
                [ "${1:-}" = -- ] && shift
                last=""
                for argument in "$@"; do last=$argument; done
                case $last in
                    *:) [ $# -ge 2 ] || { echo "usage: tailscale file cp <files...> <target>:" >&2; exit 2; } ;;
                    *) echo "final argument to 'tailscale file cp' must end in colon" >&2; exit 1 ;;
                esac
                target=${last%:}
                # As cli/file.go: the target by its Tailscale address; the fixtures' peers are
                # 100.64.0.N with the stable id nPEER<N>CNTRL; TS_FAKE_SEND_REFUSE: one the
                # daemon will not send to (its TaildropTarget reason)
                case $target in
                    100.64.0.[0-9] | 100.64.0.[0-9][0-9]) peer=nPEER${target#100.64.0.}CNTRL ;;
                    *) echo "can't send to $target: unknown target; not in your Tailnet" >&2; exit 1 ;;
                esac
                [ -n "${TS_FAKE_SEND_REFUSE:-}" ] && { echo "can't send to $target: cannot send files: $TS_FAKE_SEND_REFUSE" >&2; exit 1; }
                is_running || { echo "can't send to $target: cannot send files: local Tailscale is not connected to the tailnet" >&2; exit 1; }
                count=$#
                index=0
                for file in "$@"; do
                    index=$((index + 1))
                    [ $index -lt $count ] || break
                    [ -e "$file" ] || { echo "open $file: no such file or directory" >&2; exit 1; }
                    [ -d "$file" ] && { echo "directories not supported" >&2; exit 1; }
                    [ -r "$file" ] || { echo "open $file: permission denied" >&2; exit 1; }
                done
                # The LocalAPI's file-put needs write access (root or the operator)
                need_write "file access denied" file cp "$@"
                # Each file: progress on the bus (OutgoingFiles, as feature/taildrop/localapi.go
                # sends it: started, ~1 s updates, finished), a copy in the state dir's sent/
                mkdir -p "$STATE_DIR/sent"
                index=0
                for file in "$@"; do
                    index=$((index + 1))
                    [ $index -lt $count ] || break
                    name=${file##*/}
                    size=$(wc -c < "$file" | tr -d ' ')
                    started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
                    id=f$index$$
                    outgoing() { # sent finished succeeded
                        [ -n "${TS_FAKE_BUS_FILE:-}" ] || return 0
                        printf '{"OutgoingFiles":[{"ID":"%s","PeerID":"%s","Name":"%s","Started":"%s","DeclaredSize":%s,"Sent":%s,"Finished":%s,"Succeeded":%s}]}\n' \
                            "$id" "$peer" "$(json_string "$name")" "$started" "$size" "$1" "$2" "$3" >> "$TS_FAKE_BUS_FILE"
                    }
                    outgoing 0 false false
                    if [ "${TS_FAKE_SEND_DELAY:-0}" != 0 ]; then
                        pause "$TS_FAKE_SEND_DELAY"
                        outgoing $((size / 2)) false false
                        pause "$TS_FAKE_SEND_DELAY"
                    fi
                    if [ "${TS_FAKE_SEND_FAIL:-}" = 1 ]; then
                        outgoing $((size / 2)) true false
                        echo "500 Internal Server Error: stand-in: the peer went away" >&2
                        exit 1
                    fi
                    cp -- "$file" "$STATE_DIR/sent/$name"
                    outgoing "$size" true true
                done ;;
            get)
                need_write "file access denied" file "$@" ;;
            *) echo "usage: tailscale file <cp|get> ..." >&2; exit 2 ;;
        esac ;;
    serve | funnel)
        need_daemon
        case ${1:-} in
            status) echo "{}" ;;
            *) need_write "serve config denied" "$command" "$@" ;;
        esac ;;
    lock)
        need_daemon
        [ "${1:-}" = status ] && { echo "Tailnet lock is NOT enabled."; exit 0; }
        echo "stand-in: lock ${1:-} not replayed" >&2; exit 2 ;;
    cert)
        need_daemon
        need_write "cert access denied" cert "$@" ;;
    *)
        echo "stand-in: '$command $*' not replayed" >&2
        exit 2 ;;
esac
