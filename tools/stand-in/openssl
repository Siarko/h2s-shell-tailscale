#!/bin/sh
# h2s-stand-in: a stand-in `openssl` for the module's end-to-end tests: it reads only the stand-in
# certificates the stand-in `tailscale cert` writes ("STAND-IN <domain> notAfter=<date>"), and
# logs each call to TS_FAKE_LOG. One command is replayed:
#
#   openssl x509 -noout -enddate -in <file>   (the options in any order)
#       → "notAfter=<date>" (exit 0); a file without that text, or none: "unable to load
#         certificate" on stderr (exit 1)
#
# Anything else: exit 2 "stand-in: not replayed".
[ -n "${TS_FAKE_LOG:-}" ] && printf 'openssl %s\n' "$*" >> "$TS_FAKE_LOG"

not_replayed() { echo "stand-in: openssl $* not replayed" >&2; exit 2; }

[ "${1:-}" = x509 ] || not_replayed "$@"
all="$*"
shift
noout=false enddate=false file=""
while [ $# -gt 0 ]; do
    case $1 in
        -noout) noout=true ;;
        -enddate) enddate=true ;;
        -in) [ $# -ge 2 ] || not_replayed "$all"; file=$2; shift ;;
        *) not_replayed "$all" ;;
    esac
    shift
done
[ $noout = true ] && [ $enddate = true ] && [ -n "$file" ] || not_replayed "$all"

date=""
[ -r "$file" ] && date=$(sed -n 's/^STAND-IN .* notAfter=\(.*\)$/\1/p' "$file" | head -n 1)
if [ -z "$date" ]; then
    echo "unable to load certificate" >&2
    exit 1
fi
echo "notAfter=$date"
