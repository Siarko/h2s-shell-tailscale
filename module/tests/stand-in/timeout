#!/bin/sh
# h2s-stand-in: a stand-in `timeout` for the module's tests — it IS coreutils' timeout: it
# runs the first timeout(1) on PATH that is not a stand-in (nor a wrapper of one), with the
# same arguments. It is here so that in module test mode every program the module names
# (tailscale, timeout, curl, systemctl, openssl, pkexec) comes from this one directory (the
# manifest's testPrograms).
#
#   TS_FAKE_TIMEOUT_LOG  a file each call's arguments are appended to (one line per call)
#   TS_FAKE_CALLS        a file each call's own path ($0) is appended to
[ -n "${TS_FAKE_TIMEOUT_LOG:-}" ] && printf 'timeout %s\n' "$*" >> "$TS_FAKE_TIMEOUT_LOG"
[ -n "${TS_FAKE_CALLS:-}" ] && printf '%s\n' "$0" >> "$TS_FAKE_CALLS"
self=$(readlink -f "$0")
old_ifs=$IFS
IFS=:
for directory in $PATH; do
    IFS=$old_ifs
    candidate=$directory/timeout
    [ -f "$candidate" ] && [ -x "$candidate" ] || continue
    [ "$(readlink -f "$candidate")" = "$self" ] && continue
    grep -q 'h2s-stand-in' "$candidate" 2> /dev/null && continue
    exec "$candidate" "$@"
done
echo "stand-in timeout: no timeout(1) on PATH" >&2
exit 125
