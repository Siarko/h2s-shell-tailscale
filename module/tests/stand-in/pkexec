#!/bin/sh
# h2s-stand-in: a stand-in `pkexec` for the module's end-to-end tests: it asks nobody and
# runs nothing as root. In module test mode the shell runs the module's privileged runs
# through it (module.privileged: `pkexec <the shell's timeout> -k 3 <limit> <argv…>`) and
# never through a real pkexec. It logs what it was asked to run, then answers as pkexec does:
#
#   TS_FAKE_PKEXEC      ok (default): runs the program, with TS_FAKE_ROOT=1 so the stand-in
#                       tailscale behaves as for root | dismiss: exit 126 (the prompt was
#                       dismissed, or the password refused) | no-agent: exit 127 |
#                       unkillable: as ok, but like a process run as root it cannot be
#                       signalled by the user — SIGTERM, SIGINT and SIGHUP are ignored (by
#                       it and, inherited, by what it runs) — and it lasts at least
#                       TS_FAKE_UNKILLABLE_SECONDS (default 3) before it exits with the
#                       program's status | ask: as pkexec while its prompt is open — nothing
#                       printed, nothing run — until TERM, INT or HUP (exit 126, as pkexec
#                       ended while it asks) or TS_FAKE_ASK_SECONDS (default 30; then dismissed)
#   TS_FAKE_PKEXEC_LOG  a file each call's argv is appended to (one line, arguments
#                       separated by tabs)
#   TS_FAKE_CALLS       a file each call's own path ($0) is appended to
#
# Like the real pkexec it insists on an absolute path for the program: root's PATH is never
# searched.
[ -n "${TS_FAKE_CALLS:-}" ] && printf '%s\n' "$0" >> "$TS_FAKE_CALLS"
[ -n "${TS_FAKE_PKEXEC_LOG:-}" ] && { printf '%s' "pkexec"; for argument in "$@"; do printf '\t%s' "$argument"; done; printf '\n'; } >> "$TS_FAKE_PKEXEC_LOG"
case ${1:-} in
    "") echo "pkexec --version | --help | [--user username] PROGRAM [ARGUMENTS...]" >&2; exit 127 ;;
    /*) ;;
    *) echo "stand-in pkexec: '$1' is not an absolute path" >&2; exit 127 ;;
esac
case ${TS_FAKE_PKEXEC:-ok} in
    ok) TS_FAKE_ROOT=1 exec "$@" ;;
    unkillable)
        trap '' TERM INT HUP
        started=$(date +%s)
        TS_FAKE_ROOT=1 "$@"
        status=$?
        while [ $(($(date +%s) - started)) -lt "${TS_FAKE_UNKILLABLE_SECONDS:-3}" ]; do sleep 0.2; done
        exit "$status" ;;
    ask)
        sleeper=""
        trap '[ -n "$sleeper" ] && kill "$sleeper" 2> /dev/null; exit 126' TERM INT HUP
        sleep "${TS_FAKE_ASK_SECONDS:-30}" &
        sleeper=$!
        wait "$sleeper"
        echo "Error executing command as another user: Request dismissed" >&2; exit 126 ;;
    dismiss) echo "Error executing command as another user: Request dismissed" >&2; exit 126 ;;
    no-agent) echo "Error executing command as another user: No authentication agent found." >&2; exit 127 ;;
    *) echo "stand-in pkexec: unknown TS_FAKE_PKEXEC=$TS_FAKE_PKEXEC" >&2; exit 127 ;;
esac
