{
    "id": "tailscale",
    "name": "Tailscale",
    "version": "0.6.0",
    "api": "1.31",
    "description": "Tailscale among the shell's VPNs: connect, log in and out, accounts, this device's name and key, exit nodes, the main switches, sharing this computer (exit node, routes, SSH server, web interface), Taildrop (send files, save received ones), serve and Funnel, certificates, tailnet lock status, an exit node per network, the devices, diagnostics.",
    "main": "Main.qml",
    "widgets": [
        { "type": "tailscale", "name": "Tailscale", "widget": "TailscaleWidget.qml", "popup": "tailscale", "popupPanel": "TailscalePopup.qml",
          "settings": "TailscaleWidgetSettings.qml", "presetDefaults": { "text": "none", "badge": true, "devices": 5 } }
    ],
    "anchors": [
        { "at": "popup.network.connections.vpn.row", "place": "after", "component": "TailscaleRow.qml" },
        { "at": "settings.network_vpn.vpns.card.settings", "place": "prepend", "component": "TailscaleCard.qml" },
        { "at": "settings.network_wifi.saved.card.settings", "place": "append", "component": "NetworkExitCard.qml" },
        { "at": "settings.network_ethernet.profiles.card.settings", "place": "append", "component": "NetworkExitCard.qml" },
        { "at": "settings.network_wifi.saved.card.title", "place": "append", "component": "NetworkExitMark.qml" },
        { "at": "settings.network_ethernet.profiles.card.title", "place": "append", "component": "NetworkExitMark.qml" }
    ],
    "settingsPages": [
        { "id": "tailscale", "label": "Tailscale", "component": "TailscalePage.qml", "tab": "system", "parent": "network" }
    ],
    "settings": [
        { "key": "mod.tailscale.openLoginInBrowser", "label": "Open Tailscale's login page in the browser", "type": "bool",
          "default": true, "global": true, "hint": "Off: the login link is only shown, to copy" }
    ],
    "facts": [
        { "fact": "tailscale.connected", "label": "Tailscale connected", "type": "bool" },
        { "fact": "tailscale.exitNodeInUse", "label": "Tailscale sends internet traffic through an exit node", "type": "bool" }
    ],
    "optionalPrograms": ["tailscale", "timeout", "curl", "systemctl", "openssl", "pkexec"],
    "testPrograms": "tests/stand-in",
    "setupHints": [
        "Install Tailscale and run its service (NixOS: services.tailscale.enable = true;).",
        "Changes ask for an administrator's password through the shell's polkit agent; making your user Tailscale's operator (offered on the module's page) asks once instead."
    ],
    "tests": [
        "tests/TailscaleStateTest.qml",
        "tests/TailscaleDevicesTest.qml",
        "tests/TailscaleIoTest.qml",
        "tests/TailscaleLiveTest.qml",
        "tests/TailscaleModuleTest.qml",
        "tests/TailscaleUiTest.qml",
        "tests/TailscaleAccountsTest.qml",
        "tests/TailscaleSharingTest.qml",
        "tests/TaildropTest.qml",
        "tests/TaildropLiveTest.qml",
        "tests/ServeTest.qml",
        "tests/ServeLiveTest.qml",
        "tests/NetworkExitTest.qml",
        "tests/NetworkExitCardTest.qml",
        "tests/TailscaleWidgetTest.qml"
    ]
}
